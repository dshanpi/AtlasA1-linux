-			writel(BIT(0), host->pg + 0x18);
-			writel(BIT(1), host->pg + ((packet[i] & BIT(b)) ? 0x14 : 0x18));
+			diag_gpio_update(host, BIT(0), 0);
+			diag_gpio_update(host, BIT(1), (packet[i] & BIT(b)) ? BIT(1) : 0);
 			udelay(3);
-			writel(BIT(0), host->pg + 0x14);
