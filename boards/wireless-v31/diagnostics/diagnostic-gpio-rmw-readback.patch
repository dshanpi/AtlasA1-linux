+static void diag_gpio_update(struct sunxi_mmc_host *host, u32 clear, u32 set)
+{
+	/* Match the Linux GPIO driver's data-register RMW path. */
+	writel((readl(host->pg + 0x10) & ~clear) | set, host->pg + 0x10);
+}
+
 /* Diagnostic SDIO CMD5 using PG0/PG1 only; never changes any rail. */
 static void diag_gpio_clock(struct sunxi_mmc_host *host)
 {
-	writel(BIT(0), host->pg + 0x18);
+	diag_gpio_update(host, BIT(0), 0);
 	udelay(3);
-	writel(BIT(0), host->pg + 0x14);
+	diag_gpio_update(host, 0, BIT(0));
 	udelay(3);
 }
 
