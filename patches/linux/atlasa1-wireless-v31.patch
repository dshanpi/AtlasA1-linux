diff --git a/arch/arm64/boot/dts/allwinner/atlasa1-wireless-v31.dtsi b/arch/arm64/boot/dts/allwinner/atlasa1-wireless-v31.dtsi
new file mode 100644
index 0000000..8367e54
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/atlasa1-wireless-v31.dtsi
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* AtlasA1 SDIO1 and Bluetooth UART. The SDIO ID selects the module driver. */
+&{/aliases} {
+	mmc1 = &wifi_sdio;
+	serial1 = &bt_uart;
+};
+
+&{/pinctrl@2000000} {
+	vcc-pg-supply = <&wifi_io>;
+
+	sdio_clk_pin: sdio-clk-pin {
+		pins = "PG0";
+		function = "sdc1";
+		allwinner,pinmux = <2>;
+		drive-strength = <20>;
+		bias-pull-up;
+	};
+	sdio_data_pins: sdio-data-pins {
+		pins = "PG1", "PG2", "PG3", "PG4", "PG5";
+		function = "sdc1";
+		allwinner,pinmux = <2>;
+		drive-strength = <10>;
+		bias-pull-up;
+	};
+	bt_uart_pins: bt-uart-pins {
+		pins = "PG6", "PG7", "PG8", "PG9";
+		function = "uart1";
+		allwinner,pinmux = <2>;
+		drive-strength = <10>;
+		bias-pull-up;
+	};
+};
+
+&{/pinctrl@7025000} {
+	vcc-pm-supply = <&wifi_io>;
+};
+
+/ {
+	/* Firmware programs the shared AXP8191 DCDC1/DLDO5 rails. */
+	wifi_vbat: regulator-wifi-vbat {
+		compatible = "regulator-fixed";
+		regulator-name = "wifi-vbat";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+	wifi_io: regulator-wireless-io {
+		compatible = "regulator-fixed";
+		regulator-name = "wireless-io";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+	wireless_ccu: clock-controller@2002d10 {
+		compatible = "allwinner,t736-wireless-ccu";
+		reg = <0 0x02002d10 0 4>, <0 0x02002d1c 0 4>, <0 0x02002e04 0 4>;
+		/* SMHC1 mux, SMHC1 bus gate, fixed 24 MHz APB-UART. */
+		clocks = <&{/osc24m}>, <&{/dcxo}>, <&{/osc24m}>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+	wifi_power: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&{/pinctrl@7025000} 1 4 1>;
+		post-power-on-delay-ms = <200>;
+		power-off-delay-us = <20000>;
+	};
+	wifi_sdio: mmc@4021000 {
+		compatible = "allwinner,t736-sdio";
+		reg = <0 0x04021000 0 0x1000>;
+		interrupts = <0 162 4>;
+		clocks = <&wireless_ccu 1>, <&wireless_ccu 0>;
+		clock-names = "ahb", "mmc";
+		resets = <&wireless_ccu 0>;
+		reset-names = "ahb";
+		pinctrl-names = "default";
+		pinctrl-0 = <&sdio_clk_pin &sdio_data_pins>;
+		bus-width = <4>;
+		max-frequency = <12000000>;
+		vmmc-supply = <&wifi_vbat>;
+		vqmmc-supply = <&wifi_io>;
+		mmc-pwrseq = <&wifi_power>;
+		non-removable;
+		no-sd;
+		no-mmc;
+		cap-sdio-irq;
+	};
+	bt_uart: serial@2501000 {
+		compatible = "snps,dw-apb-uart";
+		reg = <0 0x02501000 0 0x400>;
+		interrupts = <0 3 4>;
+		reg-shift = <2>;
+		reg-io-width = <4>;
+		clocks = <&{/osc24m}>, <&wireless_ccu 2>;
+		clock-names = "baudclk", "apb_pclk";
+		resets = <&wireless_ccu 1>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_uart_pins>;
+		uart-has-rtscts;
+	};
+	bluetooth-power {
+		compatible = "rfkill-gpio";
+		label = "atlasa1-bluetooth";
+		default-blocked;
+		radio-type = "bluetooth";
+		shutdown-gpios = <&{/pinctrl@7025000} 1 0 0>;
+	};
+};
