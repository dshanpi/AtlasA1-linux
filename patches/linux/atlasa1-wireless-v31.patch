diff --git a/drivers/clk/clk-t736-wireless.c b/drivers/clk/clk-t736-wireless.c
new file mode 100644
index 0000000..b1a155d
--- /dev/null
+++ b/drivers/clk/clk-t736-wireless.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* T736 SMHC1 and UART1 clock/reset registers on the AtlasA1 board. */
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reset-controller.h>
+#include <linux/spinlock.h>
+
+struct t736_wireless_ccu {
+	struct reset_controller_dev reset;
+	void __iomem *bus[2];
+	struct clk_divider divider;
+	struct clk_gate gate;
+	spinlock_t lock;
+};
+
+static int wireless_reset_set(struct reset_controller_dev *rc, unsigned long id,
+			      bool asserted)
+{
+	struct t736_wireless_ccu *ccu = container_of(rc, struct t736_wireless_ccu, reset);
+	unsigned long flags;
+	u32 value;
+
+	if (id >= ARRAY_SIZE(ccu->bus))
+		return -EINVAL;
+
+	spin_lock_irqsave(&ccu->lock, flags);
+	value = readl(ccu->bus[id]);
+	writel(asserted ? value & ~BIT(16) : value | BIT(16), ccu->bus[id]);
+	spin_unlock_irqrestore(&ccu->lock, flags);
+	return 0;
+}
+
+static int wireless_reset_assert(struct reset_controller_dev *rc, unsigned long id)
+{
+	return wireless_reset_set(rc, id, true);
+}
+
+static int wireless_reset_deassert(struct reset_controller_dev *rc, unsigned long id)
+{
+	return wireless_reset_set(rc, id, false);
+}
+
+static const struct reset_control_ops wireless_reset_ops = {
+	.assert = wireless_reset_assert,
+	.deassert = wireless_reset_deassert,
+};
+
+static int wireless_ccu_probe(struct platform_device *pdev)
+{
+	static const char * const bus_names[] = { "t736-smhc1-bus", "t736-uart1-bus" };
+	const struct clk_parent_data sys24m = { .index = 0 };
+	struct device *dev = &pdev->dev;
+	struct t736_wireless_ccu *ccu;
+	struct clk_hw_onecell_data *clks;
+	void __iomem *module;
+	unsigned int i;
+	int ret;
+
+	ccu = devm_kzalloc(dev, sizeof(*ccu), GFP_KERNEL);
+	clks = devm_kzalloc(dev, struct_size(clks, hws, 3), GFP_KERNEL);
+	if (!ccu || !clks)
+		return -ENOMEM;
+	spin_lock_init(&ccu->lock);
+	module = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(module))
+		return PTR_ERR(module);
+
+	/* Select sys24M and N=1. The programmable M divider supplies
+	 * 800 kHz (identification) to 24 MHz (12 MHz SDR card clock).
+	 */
+	writel(readl(module) & ~(BIT(31) | GENMASK(26, 24) | GENMASK(12, 8)),
+	       module);
+	ccu->divider.reg = module;
+	ccu->divider.width = 5;
+	ccu->divider.lock = &ccu->lock;
+	ccu->gate.reg = module;
+	ccu->gate.bit_idx = 31;
+	ccu->gate.lock = &ccu->lock;
+	clks->num = 3;
+	clks->hws[0] = devm_clk_hw_register_composite_pdata(dev, "t736-smhc1",
+			&sys24m, 1, NULL, NULL, &ccu->divider.hw, &clk_divider_ops,
+			&ccu->gate.hw, &clk_gate_ops, 0);
+	if (IS_ERR(clks->hws[0]))
+		return PTR_ERR(clks->hws[0]);
+
+	for (i = 0; i < ARRAY_SIZE(ccu->bus); i++) {
+		struct clk_parent_data parent = { .index = i + 1 };
+
+		ccu->bus[i] = devm_platform_ioremap_resource(pdev, i + 1);
+		if (IS_ERR(ccu->bus[i]))
+			return PTR_ERR(ccu->bus[i]);
+		clks->hws[i + 1] = devm_clk_hw_register_gate_parent_data(dev,
+				bus_names[i], &parent, 0, ccu->bus[i], 0, 0, &ccu->lock);
+		if (IS_ERR(clks->hws[i + 1]))
+			return PTR_ERR(clks->hws[i + 1]);
+	}
+
+	ccu->reset.owner = THIS_MODULE;
+	ccu->reset.ops = &wireless_reset_ops;
+	ccu->reset.nr_resets = ARRAY_SIZE(ccu->bus);
+	ccu->reset.of_node = dev->of_node;
+	ret = devm_reset_controller_register(dev, &ccu->reset);
+	if (ret)
+		return ret;
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, clks);
+}
+
+static const struct of_device_id wireless_ccu_match[] = {
+	{ .compatible = "allwinner,t736-wireless-ccu" }, { }
+};
+
+static struct platform_driver wireless_ccu_driver = {
+	.probe = wireless_ccu_probe,
+	.driver = {
+		.name = "t736-wireless-ccu",
+		.of_match_table = wireless_ccu_match,
+	},
+};
+builtin_platform_driver(wireless_ccu_driver);
