diff --git a/drivers/clk/clk-t736-display.c b/drivers/clk/clk-t736-display.c
new file mode 100644
index 0000000000000000000000000000000000000000..b3eb28eb5419de8358344c3f78ea2746e092040d
--- /dev/null
+++ b/drivers/clk/clk-t736-display.c
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Fixed-board display CCU subset, from T736 CCU register documentation and
+ * Tina GPL ccu-sun60iw2.c. Does not retune DDR, PERI or the reference PLL.
+ * The separately owned USB AHB register is shared only through CCF callbacks,
+ * which the common clock core serializes with its global enable lock.
+ */
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reset-controller.h>
+#include <linux/spinlock.h>
+
+#define DISPLAY_CLOCKS 12
+#define DISPLAY_RESETS 8
+struct t736_display_ccu;
+struct display_gate {
+	struct clk_hw hw;
+	struct t736_display_ccu *ccu;
+	void __iomem *reg;
+	u32 mask, key;
+	unsigned long fixed_rate;
+};
+struct t736_display_ccu {
+	void __iomem *de, *vo, *pll, *ref, *ahb, *mbus, *ppu;
+	spinlock_t lock;
+	struct reset_controller_dev reset;
+	struct display_gate gates[DISPLAY_CLOCKS];
+	struct clk_hw_onecell_data *clocks;
+};
+
+static int display_gate_enable(struct clk_hw *hw)
+{
+	struct display_gate *g = container_of(hw, struct display_gate, hw);
+	unsigned long flags;
+	spin_lock_irqsave(&g->ccu->lock, flags);
+	writel(readl(g->reg) | g->key | g->mask, g->reg);
+	spin_unlock_irqrestore(&g->ccu->lock, flags);
+	return 0;
+}
+static void display_gate_disable(struct clk_hw *hw)
+{
+	struct display_gate *g = container_of(hw, struct display_gate, hw);
+	unsigned long flags;
+	spin_lock_irqsave(&g->ccu->lock, flags);
+	writel((readl(g->reg) & ~g->mask) | g->key, g->reg);
+	spin_unlock_irqrestore(&g->ccu->lock, flags);
+}
+static int display_gate_enabled(struct clk_hw *hw)
+{
+	struct display_gate *g = container_of(hw, struct display_gate, hw);
+	return !!(readl(g->reg) & g->mask);
+}
+static unsigned long display_gate_rate(struct clk_hw *hw, unsigned long parent)
+{
+	struct display_gate *g = container_of(hw, struct display_gate, hw);
+	return g->fixed_rate ? g->fixed_rate : parent;
+}
+static const struct clk_ops display_gate_ops = {
+	.enable = display_gate_enable, .disable = display_gate_disable,
+	.is_enabled = display_gate_enabled, .recalc_rate = display_gate_rate,
+};
+
+static int display_reset_update(struct reset_controller_dev *rc,
+			       unsigned long id, bool assert)
+{
+	struct t736_display_ccu *c = container_of(rc, struct t736_display_ccu, reset);
+	static const u16 offsets[] = { 0x04, 0x74, 0xc8, 0xe8, 0, 0x88, 0x88, 0x88 };
+	static const u8 bits[] = { 16, 16, 16, 16, 16, 17, 16, 18 };
+	void __iomem *reg;
+	unsigned long flags;
+	u32 v;
+	if (id >= DISPLAY_RESETS)
+		return -EINVAL;
+	reg = (id < 2 ? c->de : c->vo) + offsets[id];
+	spin_lock_irqsave(&c->lock, flags);
+	v = readl(reg);
+	writel(assert ? v & ~BIT(bits[id]) : v | BIT(bits[id]), reg);
+	spin_unlock_irqrestore(&c->lock, flags);
+	return 0;
+}
+static int display_reset_assert(struct reset_controller_dev *rc, unsigned long id)
+{ return display_reset_update(rc, id, true); }
+static int display_reset_deassert(struct reset_controller_dev *rc, unsigned long id)
+{ return display_reset_update(rc, id, false); }
+static const struct reset_control_ops display_reset_ops = {
+	.assert = display_reset_assert, .deassert = display_reset_deassert,
+};
+
+static int display_pll_prepare(struct device *dev, struct t736_display_ccu *c)
+{
+	u32 ref = readl(c->ref), v;
+	u64 rate = 26000000ULL * (((ref >> 8) & 255) + 1);
+	int ret;
+	rate /= ((ref >> 1) & 1) + 1;
+	rate /= ((ref >> 16) & 127) + 1;
+	if ((ref & (BIT(31) | BIT(28) | BIT(27))) !=
+	    (BIT(31) | BIT(28) | BIT(27)) || rate != 24000000)
+		return dev_err_probe(dev, -EINVAL,
+			"PLL reference is not locked 24 MHz: %08x (%llu Hz)\n", ref, rate);
+	/* Dedicated DE PLL: 24 MHz * 75 / 3 = 600 MHz on output 1.
+	 * Explicitly turn off its spread-spectrum modulation before retuning.
+	 */
+	writel(readl(c->de) & ~BIT(31), c->de);
+	writel(readl(c->pll + 0xc) & ~BIT(27), c->pll + 0xc);
+	v = readl(c->pll);
+	v &= ~(BIT(31) | BIT(29) | BIT(27) | BIT(26) |
+		GENMASK(18, 16) | GENMASK(15, 8) | BIT(1));
+	v |= BIT(30) | (74 << 8) | (2 << 16);
+	writel(v, c->pll);
+	udelay(10);
+	writel(v | BIT(31) | BIT(29), c->pll);
+	ret = readl_poll_timeout(c->pll, v, v & BIT(28), 10, 100000);
+	if (ret)
+		return dev_err_probe(dev, ret, "DE PLL lock timed out\n");
+	writel(v | BIT(26), c->pll);
+	/* DE source=PLL_DE_3X, divider=1, kept gated until the client enables it. */
+	v = readl(c->de) & ~(GENMASK(26, 24) | GENMASK(4, 0) | BIT(31));
+	writel(v, c->de);
+	/* HDMI CEC uses LOSC; HDMI SFR uses the fixed SYS_CLK24M source. */
+	writel(readl(c->vo + 0x7c) & ~GENMASK(26, 24), c->vo + 0x7c);
+	writel(readl(c->vo + 0x8c) & ~GENMASK(26, 24), c->vo + 0x8c);
+	dev_info(dev, "DE PLL locked at 600 MHz; HDMI PHY reference is board DCXO 26 MHz\n");
+	return 0;
+}
+
+static int t736_display_ccu_probe(struct platform_device *pdev)
+{
+	static const char * const names[] = {
+		"t736-de", "t736-de-bus", "t736-de-ahb", "t736-de-mbus",
+		"t736-vo1-top", "t736-vo1-ahb", "t736-tv0", "t736-hdmi-cec",
+		"t736-hdmi-bus", "t736-hdmi-sfr", "t736-hdcp", "t736-display-ppu"
+	};
+	/* DT input clocks: sys24m, dcxo, losc, ahb, mbus, peri300m. */
+	static const u8 parents[] = { 0, 3, 3, 4, 3, 3, 3, 2, 1, 0, 5, 1 };
+	static const u8 bits[] = { 31, 0, 5, 11, 0, 4, 0, 31, 0, 31, 31, 0 };
+	struct device *dev = &pdev->dev;
+	struct t736_display_ccu *c;
+	struct resource *r;
+	void __iomem *regs[DISPLAY_CLOCKS];
+	int i, ret;
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c) return -ENOMEM;
+	spin_lock_init(&c->lock);
+	c->de = devm_platform_ioremap_resource_byname(pdev, "de");
+	c->vo = devm_platform_ioremap_resource_byname(pdev, "vo1");
+	c->pll = devm_platform_ioremap_resource_byname(pdev, "pll-de");
+	c->ref = devm_platform_ioremap_resource_byname(pdev, "pll-ref");
+	c->mbus = devm_platform_ioremap_resource_byname(pdev, "mbus-master");
+	c->ppu = devm_platform_ioremap_resource_byname(pdev, "ppu");
+	if (IS_ERR(c->de)) return PTR_ERR(c->de);
+	if (IS_ERR(c->vo)) return PTR_ERR(c->vo);
+	if (IS_ERR(c->pll)) return PTR_ERR(c->pll);
+	if (IS_ERR(c->ref)) return PTR_ERR(c->ref);
+	if (IS_ERR(c->mbus)) return PTR_ERR(c->mbus);
+	if (IS_ERR(c->ppu)) return PTR_ERR(c->ppu);
+	r = platform_get_resource_byname(pdev, IORESOURCE_MEM, "ahb-master");
+	if (!r || resource_size(r) != 4) return -EINVAL;
+	c->ahb = devm_ioremap(dev, r->start, resource_size(r));
+	if (!c->ahb) return -ENOMEM;
+	ret = display_pll_prepare(dev, c);
+	if (ret) return ret;
+	regs[0]=c->de; regs[1]=c->de+4; regs[2]=c->ahb; regs[3]=c->mbus;
+	regs[4]=c->vo+0xc8; regs[5]=c->ahb; regs[6]=c->vo;
+	regs[7]=c->vo+0x7c; regs[8]=c->vo+0x88; regs[9]=c->vo+0x8c;
+	regs[10]=c->vo+0x90; regs[11]=c->ppu;
+	c->clocks=devm_kzalloc(dev,struct_size(c->clocks,hws,DISPLAY_CLOCKS),GFP_KERNEL);
+	if (!c->clocks) return -ENOMEM;
+	c->clocks->num=DISPLAY_CLOCKS;
+	for (i=0;i<DISPLAY_CLOCKS;i++) {
+		struct display_gate *g=&c->gates[i];
+		struct clk_parent_data parent={ .index=parents[i] };
+		struct clk_init_data init={ .name=names[i], .ops=&display_gate_ops,
+			.parent_data=&parent, .num_parents=1, .flags=CLK_GET_RATE_NOCACHE };
+		g->ccu=c; g->reg=regs[i]; g->mask=BIT(bits[i]);
+		g->key=(i==2 || i==5) ? 0x010000ff : (i==3 ? 0x41055800 : 0);
+		g->fixed_rate=i==0 ? 600000000 : 0;
+		g->hw.init=&init;
+		ret=devm_clk_hw_register(dev,&g->hw);
+		if (ret) return ret;
+		c->clocks->hws[i]=&g->hw;
+	}
+	c->reset.owner=THIS_MODULE; c->reset.ops=&display_reset_ops;
+	c->reset.nr_resets=DISPLAY_RESETS; c->reset.of_node=dev->of_node;
+	ret=devm_reset_controller_register(dev,&c->reset);
+	if (ret) return ret;
+	return devm_of_clk_add_hw_provider(dev,of_clk_hw_onecell_get,c->clocks);
+}
+static const struct of_device_id display_ccu_match[] = {
+	{ .compatible="allwinner,t736-display-ccu" }, { }
+};
+static struct platform_driver display_ccu_driver = {
+	.probe=t736_display_ccu_probe,
+	.driver={ .name="t736-display-ccu", .of_match_table=display_ccu_match },
+};
+builtin_platform_driver(display_ccu_driver);
diff --git a/drivers/clk/clk-t736-gmac.c b/drivers/clk/clk-t736-gmac.c
new file mode 100644
index 0000000000000000000000000000000000000000..688152a4c861ad13d9ae2072deed02ee434944fa
--- /dev/null
+++ b/drivers/clk/clk-t736-gmac.c
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* GMAC0 clock/reset subset. Parent PLL and bus rates are firmware-owned. */
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reset-controller.h>
+#include <linux/spinlock.h>
+
+#define N_CLOCKS 3
+#define N_RESETS 2
+#define MBUS_KEY 0x40302
+
+struct t736_gmac_ccu;
+struct t736_gmac_gate {
+	struct clk_hw hw;
+	struct t736_gmac_ccu *ccu;
+	void __iomem *reg;
+	u32 mask, key;
+	bool phy;
+};
+
+struct t736_gmac_ccu {
+	void __iomem *gmac, *mbus;
+	spinlock_t lock;
+	struct reset_controller_dev reset;
+	struct t736_gmac_gate gates[N_CLOCKS];
+	struct clk_hw_onecell_data *clocks;
+};
+
+static int t736_gmac_gate_enable(struct clk_hw *hw)
+{
+	struct t736_gmac_gate *gate = container_of(hw, struct t736_gmac_gate, hw);
+	unsigned long flags;
+	u32 value;
+
+	spin_lock_irqsave(&gate->ccu->lock, flags);
+	value = readl(gate->reg);
+	/* 150 MHz / (5 + 1) = 25 MHz. Do not change the shared PLL. */
+	if (gate->phy)
+		value = (value & ~GENMASK(4, 0)) | 5;
+	writel(value | gate->key | gate->mask, gate->reg);
+	spin_unlock_irqrestore(&gate->ccu->lock, flags);
+	return 0;
+}
+
+static void t736_gmac_gate_disable(struct clk_hw *hw)
+{
+	struct t736_gmac_gate *gate = container_of(hw, struct t736_gmac_gate, hw);
+	unsigned long flags;
+
+	spin_lock_irqsave(&gate->ccu->lock, flags);
+	writel((readl(gate->reg) | gate->key) & ~gate->mask, gate->reg);
+	spin_unlock_irqrestore(&gate->ccu->lock, flags);
+}
+
+static int t736_gmac_gate_enabled(struct clk_hw *hw)
+{
+	struct t736_gmac_gate *gate = container_of(hw, struct t736_gmac_gate, hw);
+
+	return !!(readl(gate->reg) & gate->mask);
+}
+
+static unsigned long t736_gmac_gate_rate(struct clk_hw *hw, unsigned long parent)
+{
+	struct t736_gmac_gate *gate = container_of(hw, struct t736_gmac_gate, hw);
+
+	return gate->phy ? parent / ((readl(gate->reg) & GENMASK(4, 0)) + 1) : parent;
+}
+
+static const struct clk_ops t736_gmac_gate_ops = {
+	.enable = t736_gmac_gate_enable,
+	.disable = t736_gmac_gate_disable,
+	.is_enabled = t736_gmac_gate_enabled,
+	.recalc_rate = t736_gmac_gate_rate,
+};
+
+static int t736_gmac_reset_update(struct reset_controller_dev *rc,
+				  unsigned long id, bool assert)
+{
+	struct t736_gmac_ccu *ccu = container_of(rc, struct t736_gmac_ccu, reset);
+	unsigned long flags;
+	u32 value, mask;
+
+	if (id >= N_RESETS)
+		return -EINVAL;
+	mask = BIT(16 + id);
+	spin_lock_irqsave(&ccu->lock, flags);
+	value = readl(ccu->gmac + 0xc);
+	writel(assert ? value & ~mask : value | mask, ccu->gmac + 0xc);
+	spin_unlock_irqrestore(&ccu->lock, flags);
+	return 0;
+}
+
+static int t736_gmac_reset_assert(struct reset_controller_dev *rc, unsigned long id)
+{
+	return t736_gmac_reset_update(rc, id, true);
+}
+
+static int t736_gmac_reset_deassert(struct reset_controller_dev *rc, unsigned long id)
+{
+	return t736_gmac_reset_update(rc, id, false);
+}
+
+static const struct reset_control_ops t736_gmac_reset_ops = {
+	.assert = t736_gmac_reset_assert,
+	.deassert = t736_gmac_reset_deassert,
+};
+
+static int t736_gmac_ccu_probe(struct platform_device *pdev)
+{
+	static const char * const names[] = {
+		"t736-gmac0-bus", "t736-gmac0-phy", "t736-gmac0-mbus"
+	};
+	static const u32 masks[] = { BIT(0), BIT(31), BIT(11) };
+	struct device *dev = &pdev->dev;
+	struct t736_gmac_ccu *ccu;
+	void __iomem *regs[N_CLOCKS];
+	int i, ret;
+
+	ccu = devm_kzalloc(dev, sizeof(*ccu), GFP_KERNEL);
+	if (!ccu)
+		return -ENOMEM;
+	spin_lock_init(&ccu->lock);
+	ccu->gmac = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ccu->gmac))
+		return PTR_ERR(ccu->gmac);
+	ccu->mbus = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(ccu->mbus))
+		return PTR_ERR(ccu->mbus);
+	regs[0] = ccu->gmac + 0xc;
+	regs[1] = ccu->gmac;
+	regs[2] = ccu->mbus;
+	ccu->clocks = devm_kzalloc(dev, struct_size(ccu->clocks, hws, N_CLOCKS), GFP_KERNEL);
+	if (!ccu->clocks)
+		return -ENOMEM;
+	ccu->clocks->num = N_CLOCKS;
+	for (i = 0; i < N_CLOCKS; i++) {
+		struct t736_gmac_gate *gate = &ccu->gates[i];
+		struct clk_parent_data parent = { .index = i };
+		struct clk_init_data init = {
+			.name = names[i], .ops = &t736_gmac_gate_ops,
+			.parent_data = &parent, .num_parents = 1,
+			.flags = CLK_GET_RATE_NOCACHE,
+		};
+
+		gate->ccu = ccu;
+		gate->reg = regs[i];
+		gate->mask = masks[i];
+		gate->key = i == 2 ? MBUS_KEY : 0;
+		gate->phy = i == 1;
+		gate->hw.init = &init;
+		ret = devm_clk_hw_register(dev, &gate->hw);
+		if (ret)
+			return ret;
+		ccu->clocks->hws[i] = &gate->hw;
+	}
+	ccu->reset.owner = THIS_MODULE;
+	ccu->reset.ops = &t736_gmac_reset_ops;
+	ccu->reset.nr_resets = N_RESETS;
+	ccu->reset.of_node = dev->of_node;
+	ret = devm_reset_controller_register(dev, &ccu->reset);
+	if (ret)
+		return ret;
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, ccu->clocks);
+}
+
+static const struct of_device_id t736_gmac_ccu_match[] = {
+	{ .compatible = "allwinner,t736-gmac-ccu" }, { }
+};
+static struct platform_driver t736_gmac_ccu_driver = {
+	.probe = t736_gmac_ccu_probe,
+	.driver = { .name = "t736-gmac-ccu", .of_match_table = t736_gmac_ccu_match },
+};
+builtin_platform_driver(t736_gmac_ccu_driver);
diff --git a/drivers/clk/clk-t736-gpu.c b/drivers/clk/clk-t736-gpu.c
new file mode 100644
index 0000000000000000000000000000000000000000..dfcab2002be0da5e130fa41e0429bc2d9452f60b
--- /dev/null
+++ b/drivers/clk/clk-t736-gpu.c
@@ -0,0 +1,479 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Fixed 400 MHz T736 GPU CCU subset, based on Tina ccu-sun60iw2.c.
+ * PLL_REF and PLL_PERI0 are inspected, never retuned. Shared AHB/MBUS
+ * registers are modified only in CCF enable callbacks, under the global
+ * CCF enable lock also used by the existing USB/display clock drivers.
+ */
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reset-controller.h>
+#include <linux/spinlock.h>
+
+#define GPU_RATE 400000000UL
+#define GPU_CLOCKS 6
+#define GPU_CORE 0
+#define GPU_BUS 1
+#define GPU_PERI400 2
+#define GPU_AHB 3
+#define GPU_MBUS 4
+#define GPU_PLL 5
+#define GPU_PLL_OUTPUT BIT(27)
+#define GPU_PLL_LOCK BIT(28)
+#define GPU_PLL_LOCK_DETECT BIT(29)
+#define GPU_PLL_LDO BIT(30)
+#define GPU_PLL_ENABLE BIT(31)
+#define GPU_PLL_CONTROL (GPU_PLL_OUTPUT | GPU_PLL_LOCK_DETECT | \
+			 GPU_PLL_LDO | GPU_PLL_ENABLE)
+#define GPU_PLL_READY (GPU_PLL_CONTROL | GPU_PLL_LOCK)
+#define GPU_UPDATE_REQUEST BIT(27)
+#define GPU_UPDATE_TIMEOUT_US 1000
+#define GPU_MUX_MASK GENMASK(26, 24)
+#define GPU_DIV_MASK GENMASK(3, 0)
+#define GPU_MUX_PERI400 (3U << 24)
+
+struct t736_gpu_ccu;
+struct gpu_clock {
+	struct clk_hw hw;
+	struct t736_gpu_ccu *ccu;
+	void __iomem *reg;
+	u32 mask, key;
+	unsigned int id;
+};
+
+struct t736_gpu_ccu {
+	struct device *dev;
+	void __iomem *gpu, *ref, *peri, *ahb, *mbus, *pll;
+	unsigned long dcxo_rate;
+	spinlock_t lock;
+	struct reset_controller_dev reset;
+	struct gpu_clock clock[GPU_CLOCKS];
+	struct clk_hw_onecell_data *clocks;
+};
+
+/* Manual 4.1.4.5 and 4.1.6.120: mux, cycle mask AND gating are committed
+ * through UPD. CCF enable/disable callbacks cannot sleep, so bound the atomic
+ * req/ack wait. Readback must match the requested fields after ACK clears.
+ */
+static int gpu_core_update(struct gpu_clock *g, u32 requested)
+{
+	u32 v, mask = GPU_MUX_MASK | GPU_DIV_MASK | BIT(31);
+	int ret;
+
+	writel(requested | GPU_UPDATE_REQUEST, g->reg);
+	ret = readl_poll_timeout_atomic(g->reg, v,
+			!(v & GPU_UPDATE_REQUEST), 1, GPU_UPDATE_TIMEOUT_US);
+	if (ret)
+		return ret;
+	return (v & mask) == (requested & mask) ? 0 : -EIO;
+}
+
+/* PLL_PERI0_400M = PLL_REF * (N + 1) / (M_2X + 1) / 3.
+ * PLL_REF uses the board's 26 MHz DCXO, not a presumed 24 MHz crystal.
+ */
+static unsigned long gpu_ref_rate(struct t736_gpu_ccu *c)
+{
+	u32 ref = readl(c->ref);
+	u32 ready = BIT(31) | BIT(28) | BIT(27);
+	u64 rate;
+
+	if ((ref & ready) != ready)
+		return 0;
+	rate = (u64)c->dcxo_rate * (((ref >> 8) & 0xff) + 1);
+	return div_u64(rate, (((ref >> 1) & 1) + 1) *
+		       (((ref >> 16) & 0x7f) + 1));
+}
+
+static unsigned long gpu_peri400_rate(struct t736_gpu_ccu *c)
+{
+	u32 peri = readl(c->peri);
+	u32 ready = BIT(31) | BIT(28) | BIT(27);
+	u64 rate = gpu_ref_rate(c);
+
+	if ((peri & ready) != ready)
+		return 0;
+	if (rate != 24000000)
+		return 0;
+	rate *= ((peri >> 8) & 0xff) + 1;
+	return div_u64(rate, (((peri >> 20) & 7) + 1) * 3);
+}
+
+static int gpu_pll_write(struct t736_gpu_ccu *c, u32 requested)
+{
+	writel(requested, c->pll);
+	return ((readl(c->pll) ^ requested) & ~GPU_PLL_LOCK) ? -EIO : 0;
+}
+
+static int gpu_pll_wait_lock(struct t736_gpu_ccu *c)
+{
+	unsigned int samples, locked = 0;
+
+	for (samples = 0; samples < 100 && locked < 3; samples++) {
+		locked = readl(c->pll) & GPU_PLL_LOCK ? locked + 1 : 0;
+		udelay(3);
+	}
+	if (locked != 3)
+		return -ETIMEDOUT;
+	udelay(20);
+	return readl(c->pll) & GPU_PLL_LOCK ? 0 : -EIO;
+}
+
+/* PLL_GPU0 is a power/isolation prerequisite even while GPU0_CLK selects
+ * PERI400. Match the verified Tina sequence, preserving N/M and SDM fields.
+ * The power provider keeps a real CCF enable reference for its lifetime.
+ */
+static int gpu_pll_enable(struct clk_hw *hw)
+{
+	struct gpu_clock *g = container_of(hw, struct gpu_clock, hw);
+	struct t736_gpu_ccu *c = g->ccu;
+	unsigned long flags;
+	u32 original, value;
+	int ret;
+
+	if (gpu_ref_rate(c) != 24000000)
+		return -EINVAL;
+	spin_lock_irqsave(&c->lock, flags);
+	original = readl(c->pll);
+	if ((original & GPU_PLL_READY) == GPU_PLL_READY) {
+		ret = gpu_pll_wait_lock(c);
+		goto out;
+	}
+	ret = gpu_pll_write(c, original & ~GPU_PLL_OUTPUT);
+	if (ret)
+		goto restore;
+	ret = gpu_pll_write(c, readl(c->pll) | GPU_PLL_LDO);
+	if (ret)
+		goto restore;
+	ret = gpu_pll_write(c, readl(c->pll) | GPU_PLL_ENABLE);
+	if (ret)
+		goto restore;
+	ret = gpu_pll_write(c, readl(c->pll) | GPU_PLL_LOCK_DETECT);
+	if (ret)
+		goto restore;
+	ret = gpu_pll_wait_lock(c);
+	if (ret)
+		goto restore;
+	ret = gpu_pll_write(c, readl(c->pll) | GPU_PLL_OUTPUT);
+	if (ret)
+		goto restore;
+	value = readl(c->pll);
+	if ((value & GPU_PLL_READY) != GPU_PLL_READY ||
+	    ((value ^ original) & ~GPU_PLL_READY)) {
+		ret = -EIO;
+		goto restore;
+	}
+	goto out;
+restore:
+	/* Continue rollback even if a write fails; never touch a shared PLL. */
+	gpu_pll_write(c, readl(c->pll) & ~GPU_PLL_OUTPUT);
+	gpu_pll_write(c, readl(c->pll) & ~GPU_PLL_LOCK_DETECT);
+	gpu_pll_write(c, readl(c->pll) & ~GPU_PLL_ENABLE);
+	if (gpu_pll_write(c, original))
+		dev_err(c->dev, "PLL_GPU0 rollback readback failed\n");
+out:
+	spin_unlock_irqrestore(&c->lock, flags);
+	if (ret)
+		dev_err(c->dev, "PLL_GPU0 enable/lock failed: %d\n", ret);
+	return ret;
+}
+
+static void gpu_pll_disable(struct clk_hw *hw)
+{
+	struct gpu_clock *g = container_of(hw, struct gpu_clock, hw);
+	struct t736_gpu_ccu *c = g->ccu;
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&c->lock, flags);
+	ret = gpu_pll_write(c, readl(c->pll) & ~GPU_PLL_OUTPUT);
+	ret |= gpu_pll_write(c, readl(c->pll) & ~GPU_PLL_LOCK_DETECT);
+	ret |= gpu_pll_write(c, readl(c->pll) & ~GPU_PLL_ENABLE);
+	spin_unlock_irqrestore(&c->lock, flags);
+	if (ret)
+		dev_err(c->dev, "PLL_GPU0 disable readback failed\n");
+}
+
+static int gpu_pll_enabled(struct clk_hw *hw)
+{
+	struct gpu_clock *g = container_of(hw, struct gpu_clock, hw);
+
+	return (readl(g->reg) & GPU_PLL_READY) == GPU_PLL_READY;
+}
+
+static int gpu_clock_enable(struct clk_hw *hw)
+{
+	struct gpu_clock *g = container_of(hw, struct gpu_clock, hw);
+	unsigned long flags;
+	u32 v;
+	int ret = 0;
+
+	if (g->id == GPU_CORE && gpu_peri400_rate(g->ccu) != GPU_RATE)
+		return -EINVAL;
+	spin_lock_irqsave(&g->ccu->lock, flags);
+	v = readl(g->reg);
+	if (g->id == GPU_CORE) {
+		/* Commit the fixed source and output gate in one update request. */
+		v &= ~(GPU_MUX_MASK | GPU_DIV_MASK | GPU_UPDATE_REQUEST);
+		ret = gpu_core_update(g, v | GPU_MUX_PERI400 | BIT(31));
+		if (ret)
+			writel((readl(g->reg) & ~BIT(31)) | GPU_UPDATE_REQUEST, g->reg);
+	} else {
+		writel(v | g->key | g->mask, g->reg);
+		readl(g->reg);
+	}
+	spin_unlock_irqrestore(&g->ccu->lock, flags);
+	if (ret)
+		dev_err(g->ccu->dev, "GPU clock enable update/ACK failed: %d; gate-off requested\n", ret);
+	return ret;
+}
+
+static void gpu_clock_disable(struct clk_hw *hw)
+{
+	struct gpu_clock *g = container_of(hw, struct gpu_clock, hw);
+	unsigned long flags;
+	u32 v;
+	int ret = 0;
+
+	spin_lock_irqsave(&g->ccu->lock, flags);
+	v = (readl(g->reg) | g->key) & ~g->mask;
+	if (g->id == GPU_CORE)
+		ret = gpu_core_update(g, v);
+	else
+		writel(v, g->reg);
+	spin_unlock_irqrestore(&g->ccu->lock, flags);
+	if (ret)
+		dev_err(g->ccu->dev, "GPU clock disable update/ACK failed: %d\n", ret);
+}
+
+static int gpu_clock_enabled(struct clk_hw *hw)
+{
+	struct gpu_clock *g = container_of(hw, struct gpu_clock, hw);
+
+	return !!(readl(g->reg) & g->mask);
+}
+
+static unsigned long gpu_clock_rate(struct clk_hw *hw, unsigned long parent)
+{
+	struct gpu_clock *g = container_of(hw, struct gpu_clock, hw);
+	u32 v;
+
+	if (g->id == GPU_PERI400)
+		return gpu_peri400_rate(g->ccu);
+	if (g->id == GPU_PLL) {
+		v = readl(g->reg);
+		if ((v & GPU_PLL_READY) != GPU_PLL_READY)
+			return 0;
+		return div_u64((u64)gpu_ref_rate(g->ccu) *
+			       (((v >> 8) & 0xff) + 1),
+			       ((((v >> 20) & 7) + 1) *
+				(((v >> 1) & 1) + 1)));
+	}
+	if (g->id == GPU_CORE) {
+		v = readl(g->reg);
+		if ((v & GPU_MUX_MASK) != GPU_MUX_PERI400 ||
+		    (v & (GPU_DIV_MASK | GPU_UPDATE_REQUEST)))
+			return 0;
+	}
+	return parent;
+}
+
+static long gpu_clock_round_rate(struct clk_hw *hw, unsigned long rate,
+				unsigned long *parent)
+{
+	return rate == GPU_RATE ? GPU_RATE : -EINVAL;
+}
+
+static int gpu_clock_set_rate(struct clk_hw *hw, unsigned long rate,
+			      unsigned long parent)
+{
+	struct gpu_clock *g = container_of(hw, struct gpu_clock, hw);
+	unsigned long flags;
+	u32 v;
+	int ret;
+
+	if (rate != GPU_RATE || gpu_peri400_rate(g->ccu) != GPU_RATE)
+		return -EINVAL;
+	spin_lock_irqsave(&g->ccu->lock, flags);
+	v = readl(g->reg);
+	if ((v & BIT(31)) &&
+	    ((v & GPU_MUX_MASK) != GPU_MUX_PERI400 || (v & GPU_DIV_MASK))) {
+		spin_unlock_irqrestore(&g->ccu->lock, flags);
+		return -EBUSY;
+	}
+	v &= ~(GPU_MUX_MASK | GPU_DIV_MASK | GPU_UPDATE_REQUEST);
+	ret = gpu_core_update(g, v | GPU_MUX_PERI400);
+	spin_unlock_irqrestore(&g->ccu->lock, flags);
+	return ret;
+}
+
+static const struct clk_ops gpu_core_ops = {
+	.enable = gpu_clock_enable, .disable = gpu_clock_disable,
+	.is_enabled = gpu_clock_enabled, .recalc_rate = gpu_clock_rate,
+	.round_rate = gpu_clock_round_rate, .set_rate = gpu_clock_set_rate,
+};
+static const struct clk_ops gpu_gate_ops = {
+	.enable = gpu_clock_enable, .disable = gpu_clock_disable,
+	.is_enabled = gpu_clock_enabled, .recalc_rate = gpu_clock_rate,
+};
+static const struct clk_ops gpu_peri_ops = {
+	.recalc_rate = gpu_clock_rate,
+};
+static const struct clk_ops gpu_pll_ops = {
+	.enable = gpu_pll_enable, .disable = gpu_pll_disable,
+	.is_enabled = gpu_pll_enabled, .recalc_rate = gpu_clock_rate,
+};
+
+static int gpu_reset_update(struct reset_controller_dev *rc,
+			    unsigned long id, bool assert)
+{
+	struct t736_gpu_ccu *c = container_of(rc, struct t736_gpu_ccu, reset);
+	unsigned long flags;
+	u32 v;
+
+	if (id)
+		return -EINVAL;
+	spin_lock_irqsave(&c->lock, flags);
+	v = readl(c->gpu + 4);
+	writel(assert ? v & ~BIT(16) : v | BIT(16), c->gpu + 4);
+	v = readl(c->gpu + 4);
+	spin_unlock_irqrestore(&c->lock, flags);
+	return !!(v & BIT(16)) == !assert ? 0 : -EIO;
+}
+static int gpu_reset_assert(struct reset_controller_dev *rc, unsigned long id)
+{ return gpu_reset_update(rc, id, true); }
+static int gpu_reset_deassert(struct reset_controller_dev *rc, unsigned long id)
+{ return gpu_reset_update(rc, id, false); }
+static int gpu_reset_status(struct reset_controller_dev *rc, unsigned long id)
+{
+	struct t736_gpu_ccu *c = container_of(rc, struct t736_gpu_ccu, reset);
+	unsigned long flags;
+	u32 v;
+
+	if (id)
+		return -EINVAL;
+	spin_lock_irqsave(&c->lock, flags);
+	v = readl(c->gpu + 4);
+	spin_unlock_irqrestore(&c->lock, flags);
+	/* Tina CCU: hardware 1 means deasserted; reset API 0 means deasserted. */
+	return !(v & BIT(16));
+}
+static const struct reset_control_ops gpu_reset_ops = {
+	.assert = gpu_reset_assert, .deassert = gpu_reset_deassert,
+	.status = gpu_reset_status,
+};
+
+/* Existing USB/display providers own these shared resource reservations. */
+static void __iomem *gpu_map_shared(struct platform_device *pdev,
+				   const char *name)
+{
+	struct resource *r = platform_get_resource_byname(pdev, IORESOURCE_MEM, name);
+	void __iomem *base;
+
+	if (!r || resource_size(r) != 4)
+		return ERR_PTR(-EINVAL);
+	base = devm_ioremap(&pdev->dev, r->start, resource_size(r));
+	return base ? base : ERR_PTR(-ENOMEM);
+}
+
+static int t736_gpu_ccu_probe(struct platform_device *pdev)
+{
+	static const char * const names[GPU_CLOCKS] = {
+		"t736-gpu", "t736-gpu-bus", "t736-gpu-peri400",
+		"t736-gpu-ahb", "t736-gpu-mbus", "t736-pll-gpu0"
+	};
+	static const u8 bits[GPU_CLOCKS] = { 31, 0, 0, 7, 16, 31 };
+	struct device *dev = &pdev->dev;
+	struct t736_gpu_ccu *c;
+	struct clk *dcxo;
+	void __iomem *regs[GPU_CLOCKS];
+	/* Register the measured parent before the core clock. */
+	static const u8 order[GPU_CLOCKS] = { 2, 0, 1, 3, 4, 5 };
+	int i, n, ret;
+
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	c->dev = dev;
+	spin_lock_init(&c->lock);
+	dcxo = devm_clk_get(dev, "dcxo");
+	if (IS_ERR(dcxo))
+		return dev_err_probe(dev, PTR_ERR(dcxo), "missing DCXO\n");
+	c->dcxo_rate = clk_get_rate(dcxo);
+	c->gpu = devm_platform_ioremap_resource_byname(pdev, "gpu");
+	c->ref = gpu_map_shared(pdev, "pll-ref");
+	c->peri = gpu_map_shared(pdev, "pll-peri0");
+	c->ahb = gpu_map_shared(pdev, "ahb-master");
+	c->mbus = gpu_map_shared(pdev, "mbus-master");
+	c->pll = devm_platform_ioremap_resource_byname(pdev, "pll-gpu0");
+	if (IS_ERR(c->gpu)) return PTR_ERR(c->gpu);
+	if (IS_ERR(c->ref)) return PTR_ERR(c->ref);
+	if (IS_ERR(c->peri)) return PTR_ERR(c->peri);
+	if (IS_ERR(c->ahb)) return PTR_ERR(c->ahb);
+	if (IS_ERR(c->mbus)) return PTR_ERR(c->mbus);
+	if (IS_ERR(c->pll)) return PTR_ERR(c->pll);
+	if (gpu_peri400_rate(c) != GPU_RATE)
+		return dev_err_probe(dev, -EINVAL,
+			"need locked PLL_REF=24 MHz, PERI0/2x/3=400 MHz: dcxo=%lu ref=%08x peri=%08x\n",
+			c->dcxo_rate, readl(c->ref), readl(c->peri));
+	c->clocks = devm_kzalloc(dev, struct_size(c->clocks, hws, GPU_CLOCKS), GFP_KERNEL);
+	if (!c->clocks)
+		return -ENOMEM;
+	c->clocks->num = GPU_CLOCKS;
+	regs[0] = c->gpu; regs[1] = c->gpu + 4; regs[2] = NULL;
+	regs[3] = c->ahb; regs[4] = c->mbus; regs[5] = c->pll;
+	for (n = 0; n < GPU_CLOCKS; n++) {
+		struct clk_parent_data parent = { .fw_name = "dcxo" };
+		struct clk_init_data init = {
+			.parent_data = &parent, .num_parents = 1,
+			.flags = CLK_GET_RATE_NOCACHE,
+		};
+		struct gpu_clock *g;
+
+		i = order[n];
+		g = &c->clock[i];
+		init.name = names[i];
+		init.ops = i == GPU_CORE ? &gpu_core_ops :
+			(i == GPU_PERI400 ? &gpu_peri_ops :
+			 (i == GPU_PLL ? &gpu_pll_ops : &gpu_gate_ops));
+		if (i == GPU_CORE) {
+			parent.fw_name = NULL;
+			parent.hw = &c->clock[GPU_PERI400].hw;
+		} else if (i == GPU_BUS || i == GPU_AHB) {
+			parent.fw_name = "ahb";
+		} else if (i == GPU_MBUS) {
+			parent.fw_name = "mbus";
+		}
+		g->ccu = c; g->id = i; g->reg = regs[i]; g->mask = BIT(bits[i]);
+		g->key = i == GPU_AHB ? 0x010000ff : (i == GPU_MBUS ? 0x41055800 : 0);
+		g->hw.init = &init;
+		ret = devm_clk_hw_register(dev, &g->hw);
+		if (ret)
+			return ret;
+		c->clocks->hws[i] = &g->hw;
+	}
+	c->reset.owner = THIS_MODULE; c->reset.ops = &gpu_reset_ops;
+	c->reset.nr_resets = 1; c->reset.of_node = dev->of_node;
+	ret = devm_reset_controller_register(dev, &c->reset);
+	if (ret)
+		return ret;
+	ret = devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, c->clocks);
+	if (!ret)
+		dev_info(dev, "GPU fixed PERI400 clock with independent PLL_GPU0 power prerequisite\n");
+	return ret;
+}
+
+static const struct of_device_id gpu_ccu_match[] = {
+	{ .compatible = "allwinner,t736-gpu-ccu" }, { }
+};
+static struct platform_driver gpu_ccu_driver = {
+	.probe = t736_gpu_ccu_probe,
+	.driver = { .name = "t736-gpu-ccu", .of_match_table = gpu_ccu_match,
+		    .suppress_bind_attrs = true },
+};
+builtin_platform_driver(gpu_ccu_driver);
diff --git a/drivers/clk/clk-t736-usb.c b/drivers/clk/clk-t736-usb.c
new file mode 100644
index 0000000000000000000000000000000000000000..058708773bb3c2bb79139a96cca79ba4e58afdde
--- /dev/null
+++ b/drivers/clk/clk-t736-usb.c
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Initial USB1 clock/reset subset; does not claim ownership of the whole CCU. */
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reset-controller.h>
+#include <linux/spinlock.h>
+
+#define N_CLOCKS 6
+#define N_RESETS 3
+
+struct t736_usb_ccu;
+struct t736_gate {
+	struct clk_hw hw;
+	struct t736_usb_ccu *ccu;
+	void __iomem *reg;
+	u32 mask, key, mux_mask;
+};
+
+struct t736_usb_ccu {
+	void __iomem *usb, *msi, *master;
+	spinlock_t lock;
+	struct reset_controller_dev reset;
+	struct t736_gate gates[N_CLOCKS];
+	struct clk_hw_onecell_data *clocks;
+};
+
+static int t736_gate_enable(struct clk_hw *hw)
+{
+	struct t736_gate *gate = container_of(hw, struct t736_gate, hw);
+	unsigned long flags;
+	u32 value;
+
+	spin_lock_irqsave(&gate->ccu->lock, flags);
+	value = readl(gate->reg);
+	/* USB reference mux value 0 selects the existing 24 MHz system clock. */
+	writel((value & ~gate->mux_mask) | gate->key | gate->mask, gate->reg);
+	spin_unlock_irqrestore(&gate->ccu->lock, flags);
+	return 0;
+}
+
+static void t736_gate_disable(struct clk_hw *hw)
+{
+	struct t736_gate *gate = container_of(hw, struct t736_gate, hw);
+	unsigned long flags;
+
+	spin_lock_irqsave(&gate->ccu->lock, flags);
+	writel((readl(gate->reg) | gate->key) & ~gate->mask, gate->reg);
+	spin_unlock_irqrestore(&gate->ccu->lock, flags);
+}
+
+static int t736_gate_enabled(struct clk_hw *hw)
+{
+	struct t736_gate *gate = container_of(hw, struct t736_gate, hw);
+
+	return !!(readl(gate->reg) & gate->mask);
+}
+
+static const struct clk_ops t736_gate_ops = {
+	.enable = t736_gate_enable,
+	.disable = t736_gate_disable,
+	.is_enabled = t736_gate_enabled,
+};
+
+static int t736_reset_update(struct reset_controller_dev *rc, unsigned long id,
+			    bool assert)
+{
+	struct t736_usb_ccu *ccu = container_of(rc, struct t736_usb_ccu, reset);
+	static const u32 offsets[] = { 0x08, 0x0c, 0x0c };
+	static const u32 masks[] = { BIT(30), BIT(20), BIT(16) };
+	unsigned long flags;
+	u32 value;
+
+	if (id >= N_RESETS)
+		return -EINVAL;
+	spin_lock_irqsave(&ccu->lock, flags);
+	value = readl(ccu->usb + offsets[id]);
+	writel(assert ? value & ~masks[id] : value | masks[id],
+	       ccu->usb + offsets[id]);
+	spin_unlock_irqrestore(&ccu->lock, flags);
+	return 0;
+}
+
+static int t736_reset_assert(struct reset_controller_dev *rc, unsigned long id)
+{
+	return t736_reset_update(rc, id, true);
+}
+
+static int t736_reset_deassert(struct reset_controller_dev *rc, unsigned long id)
+{
+	return t736_reset_update(rc, id, false);
+}
+
+static const struct reset_control_ops t736_reset_ops = {
+	.assert = t736_reset_assert,
+	.deassert = t736_reset_deassert,
+};
+
+static int t736_usb_ccu_probe(struct platform_device *pdev)
+{
+	static const char * const names[] = {
+		"t736-usb-ref", "t736-usb1-ehci", "t736-usb1-ohci",
+		"t736-usb1-ohci-clock", "t736-usb-msi", "t736-usb-master"
+	};
+	static const u32 masks[] = { BIT(31), BIT(4), BIT(0), BIT(31), BIT(0), BIT(9) };
+	struct clk_parent_data parent = { .index = 0 };
+	struct device *dev = &pdev->dev;
+	struct t736_usb_ccu *ccu;
+	void __iomem *regs[N_CLOCKS];
+	int i, ret;
+
+	ccu = devm_kzalloc(dev, sizeof(*ccu), GFP_KERNEL);
+	if (!ccu)
+		return -ENOMEM;
+	spin_lock_init(&ccu->lock);
+	ccu->usb = devm_platform_ioremap_resource(pdev, 0);
+	ccu->msi = devm_platform_ioremap_resource(pdev, 1);
+	ccu->master = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(ccu->usb))
+		return PTR_ERR(ccu->usb);
+	if (IS_ERR(ccu->msi))
+		return PTR_ERR(ccu->msi);
+	if (IS_ERR(ccu->master))
+		return PTR_ERR(ccu->master);
+	regs[0] = ccu->usb + 0x40;
+	regs[1] = ccu->usb + 0x0c;
+	regs[2] = ccu->usb + 0x0c;
+	regs[3] = ccu->usb + 0x08;
+	regs[4] = ccu->msi;
+	regs[5] = ccu->master;
+	ccu->clocks = devm_kzalloc(dev, struct_size(ccu->clocks, hws, N_CLOCKS), GFP_KERNEL);
+	if (!ccu->clocks)
+		return -ENOMEM;
+	ccu->clocks->num = N_CLOCKS;
+	for (i = 0; i < N_CLOCKS; i++) {
+		struct t736_gate *gate = &ccu->gates[i];
+		struct clk_init_data init = {
+			.name = names[i], .ops = &t736_gate_ops,
+			.parent_data = &parent, .num_parents = 1,
+		};
+
+		gate->ccu = ccu;
+		gate->reg = regs[i];
+		gate->mask = masks[i];
+		gate->key = i == 5 ? 0x010000ff : 0;
+		gate->mux_mask = i == 0 ? GENMASK(26, 24) : 0;
+		gate->hw.init = &init;
+		ret = devm_clk_hw_register(dev, &gate->hw);
+		if (ret)
+			return ret;
+		ccu->clocks->hws[i] = &gate->hw;
+	}
+	ccu->reset.owner = THIS_MODULE;
+	ccu->reset.ops = &t736_reset_ops;
+	ccu->reset.nr_resets = N_RESETS;
+	ccu->reset.of_node = dev->of_node;
+	ret = devm_reset_controller_register(dev, &ccu->reset);
+	if (ret)
+		return ret;
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, ccu->clocks);
+}
+
+static const struct of_device_id t736_usb_ccu_match[] = {
+	{ .compatible = "allwinner,t736-usb-ccu" }, { }
+};
+static struct platform_driver t736_usb_ccu_driver = {
+	.probe = t736_usb_ccu_probe,
+	.driver = { .name = "t736-usb-ccu", .of_match_table = t736_usb_ccu_match },
+};
+builtin_platform_driver(t736_usb_ccu_driver);
diff --git a/drivers/clk/clk-t736-ve.c b/drivers/clk/clk-t736-ve.c
new file mode 100644
index 0000000000000000000000000000000000000000..019af3a8e7c1dd59c2459b61d477660aaf410888
--- /dev/null
+++ b/drivers/clk/clk-t736-ve.c
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* T736 decoder-only CCU subset. Fixed PERI0_800M / 2, no PLL writes.
+ * Manual 4.1.6.114: VE_DEC has a plain divider, NOT the GPU UPD handshake.
+ * Shared master gates use the same CCF enable serialization as USB/display.
+ */
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/reset-controller.h>
+
+#define VE_RATE 400000000UL
+#define VE_CLOCKS 8
+#define VE_CORE 0
+#define VE_PERI800 7
+#define VE_MUX GENMASK(26, 24)
+#define VE_DIV GENMASK(4, 0)
+#define VE_FIXED ((2U << 24) | 1)
+
+struct ve_ccu;
+struct ve_clk {
+	struct clk_hw hw;
+	struct ve_ccu *ccu;
+	void __iomem *reg;
+	u32 mask;
+	unsigned int id;
+};
+struct ve_ccu {
+	void __iomem *ve, *ref, *peri;
+	unsigned long dcxo;
+	spinlock_t lock;
+	struct reset_controller_dev reset;
+	struct ve_clk clock[VE_CLOCKS];
+	struct clk_hw_onecell_data *clocks;
+};
+
+static unsigned long ve_peri_rate(struct ve_ccu *c)
+{
+	u32 ref = readl(c->ref), peri = readl(c->peri);
+	u32 rready = BIT(31) | BIT(30) | BIT(28) | BIT(27);
+	u32 pready = BIT(31) | BIT(30) | BIT(28) | BIT(26);
+	u64 rate;
+
+	if ((ref & rready) != rready || (peri & pready) != pready)
+		return 0;
+	rate = div_u64((u64)c->dcxo * (((ref >> 8) & 0xff) + 1),
+			(((ref >> 1) & 1) + 1) * (((ref >> 16) & 0x7f) + 1));
+	if (rate != 24000000)
+		return 0;
+	return div_u64(rate * (((peri >> 8) & 0xff) + 1),
+			(((peri >> 1) & 1) + 1) * (((peri >> 16) & 7) + 1));
+}
+
+static int ve_clk_enable(struct clk_hw *hw)
+{
+	struct ve_clk *g = container_of(hw, struct ve_clk, hw);
+	unsigned long flags;
+	u32 v, check;
+	int ret = 0;
+
+	if (g->id == VE_CORE && ve_peri_rate(g->ccu) != 800000000)
+		return -ERANGE;
+	spin_lock_irqsave(&g->ccu->lock, flags);
+	v = readl(g->reg);
+	if (g->id == VE_CORE) {
+		if ((v & BIT(31)) && (v & (VE_MUX | VE_DIV)) != VE_FIXED) {
+			ret = -EBUSY;
+			goto out;
+		}
+		v = (v & ~(VE_MUX | VE_DIV)) | VE_FIXED;
+	}
+	/* Donor "KEY" constants are other real gate bits in the manual, not a
+	 * write-unlock field. Preserve every unrelated gate instead. */
+	v |= g->mask;
+	writel(v, g->reg);
+	check = readl(g->reg);
+	if ((check & g->mask) != g->mask ||
+	    (g->id == VE_CORE && (check & (VE_MUX | VE_DIV)) != VE_FIXED))
+		ret = -EIO;
+out:
+	spin_unlock_irqrestore(&g->ccu->lock, flags);
+	return ret;
+}
+
+static void ve_clk_disable(struct clk_hw *hw)
+{
+	struct ve_clk *g = container_of(hw, struct ve_clk, hw);
+	unsigned long flags;
+
+	/* Shared IOMMU1 reset is only deasserted during enable, never asserted;
+	 * keep it and its clocks intact when dropping a local enable reference. */
+	if (g->id == 5 || g->id == 6)
+		return;
+	spin_lock_irqsave(&g->ccu->lock, flags);
+	writel(readl(g->reg) & ~g->mask, g->reg);
+	readl(g->reg);
+	spin_unlock_irqrestore(&g->ccu->lock, flags);
+}
+
+static int ve_clk_enabled(struct clk_hw *hw)
+{
+	struct ve_clk *g = container_of(hw, struct ve_clk, hw);
+	return (readl(g->reg) & g->mask) == g->mask;
+}
+
+static unsigned long ve_clk_rate(struct clk_hw *hw, unsigned long parent)
+{
+	struct ve_clk *g = container_of(hw, struct ve_clk, hw);
+	if (g->id == VE_PERI800)
+		return ve_peri_rate(g->ccu);
+	if (g->id == VE_CORE) {
+		u32 v = readl(g->reg);
+		return (v & VE_MUX) == (2U << 24) ? parent / ((v & VE_DIV) + 1) : 0;
+	}
+	return parent;
+}
+
+static long ve_round_rate(struct clk_hw *hw, unsigned long rate, unsigned long *parent)
+{
+	return rate == VE_RATE ? VE_RATE : -EINVAL;
+}
+
+static int ve_set_rate(struct clk_hw *hw, unsigned long rate, unsigned long parent)
+{
+	struct ve_clk *g = container_of(hw, struct ve_clk, hw);
+	unsigned long flags;
+	u32 v;
+	int ret = 0;
+	if (rate != VE_RATE || ve_peri_rate(g->ccu) != 800000000)
+		return -EINVAL;
+	spin_lock_irqsave(&g->ccu->lock, flags);
+	v = readl(g->reg);
+	if ((v & BIT(31)) && (v & (VE_MUX | VE_DIV)) != VE_FIXED)
+		ret = -EBUSY;
+	else {
+		writel((v & ~(VE_MUX | VE_DIV)) | VE_FIXED, g->reg);
+		if ((readl(g->reg) & (VE_MUX | VE_DIV)) != VE_FIXED)
+			ret = -EIO;
+	}
+	spin_unlock_irqrestore(&g->ccu->lock, flags);
+	return ret;
+}
+
+static const struct clk_ops ve_core_ops = {
+	.enable = ve_clk_enable, .disable = ve_clk_disable,
+	.is_enabled = ve_clk_enabled, .recalc_rate = ve_clk_rate,
+	.round_rate = ve_round_rate, .set_rate = ve_set_rate,
+};
+static const struct clk_ops ve_gate_ops = {
+	.enable = ve_clk_enable, .disable = ve_clk_disable,
+	.is_enabled = ve_clk_enabled, .recalc_rate = ve_clk_rate,
+};
+static const struct clk_ops ve_parent_ops = { .recalc_rate = ve_clk_rate };
+
+static int ve_reset_update(struct reset_controller_dev *rc, unsigned long id, bool assert)
+{
+	struct ve_ccu *c = container_of(rc, struct ve_ccu, reset);
+	unsigned long flags;
+	u32 v;
+	if (id)
+		return -EINVAL;
+	spin_lock_irqsave(&c->lock, flags);
+	v = readl(c->ve + 4);
+	writel(assert ? v & ~BIT(18) : v | BIT(18), c->ve + 4);
+	v = readl(c->ve + 4);
+	spin_unlock_irqrestore(&c->lock, flags);
+	/* Readback verifies CCU reset state, not a promise of AXI drain. */
+	return !!(v & BIT(18)) == !assert ? 0 : -EIO;
+}
+static int ve_reset_assert(struct reset_controller_dev *rc, unsigned long id)
+{ return ve_reset_update(rc, id, true); }
+static int ve_reset_deassert(struct reset_controller_dev *rc, unsigned long id)
+{ return ve_reset_update(rc, id, false); }
+static int ve_reset_status(struct reset_controller_dev *rc, unsigned long id)
+{
+	struct ve_ccu *c = container_of(rc, struct ve_ccu, reset);
+	return id ? -EINVAL : !(readl(c->ve + 4) & BIT(18));
+}
+static const struct reset_control_ops ve_reset_ops = {
+	.assert = ve_reset_assert, .deassert = ve_reset_deassert, .status = ve_reset_status,
+};
+
+static void __iomem *ve_shared(struct platform_device *pdev, const char *name)
+{
+	struct resource *r = platform_get_resource_byname(pdev, IORESOURCE_MEM, name);
+	void __iomem *base;
+	if (!r || resource_size(r) != 4)
+		return ERR_PTR(-EINVAL);
+	base = devm_ioremap(&pdev->dev, r->start, 4);
+	return base ? base : ERR_PTR(-ENOMEM);
+}
+
+static int ve_ccu_probe(struct platform_device *pdev)
+{
+	static const char * const names[] = { "t736-ve-dec", "t736-ve-bus",
+		"t736-ve-ahb", "t736-ve-mbus-master", "t736-ve-mbus",
+		"t736-ve-iommu1-sys", "t736-ve-iommu1-mbus", "t736-ve-peri800" };
+	static const char * const regs[] = { NULL, NULL, "ahb-master", "mbus-master",
+		"mbus-gate", "iommu1-sys", "mbus-master", "pll-peri0" };
+	static const u32 masks[] = { BIT(31), BIT(2), BIT(0), BIT(14), BIT(18),
+		BIT(16) | GENMASK(2, 0), BIT(1), 0 };
+	static const u8 order[] = { 7, 0, 1, 2, 3, 4, 5, 6 };
+	struct device *dev = &pdev->dev;
+	struct ve_ccu *c;
+	struct clk *dcxo;
+	int n, ret;
+
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c) return -ENOMEM;
+	spin_lock_init(&c->lock);
+	dcxo = devm_clk_get(dev, "dcxo");
+	if (IS_ERR(dcxo)) return PTR_ERR(dcxo);
+	c->dcxo = clk_get_rate(dcxo);
+	c->ve = devm_platform_ioremap_resource_byname(pdev, "ve");
+	c->ref = ve_shared(pdev, "pll-ref");
+	c->peri = ve_shared(pdev, "pll-peri0");
+	if (IS_ERR(c->ve)) return PTR_ERR(c->ve);
+	if (IS_ERR(c->ref)) return PTR_ERR(c->ref);
+	if (IS_ERR(c->peri)) return PTR_ERR(c->peri);
+	if (ve_peri_rate(c) != 800000000)
+		return dev_err_probe(dev, -ERANGE, "need locked PERI0_800M, ref=%08x peri=%08x\n",
+			readl(c->ref), readl(c->peri));
+	c->clocks = devm_kzalloc(dev, struct_size(c->clocks, hws, VE_CLOCKS), GFP_KERNEL);
+	if (!c->clocks) return -ENOMEM;
+	c->clocks->num = VE_CLOCKS;
+	for (n = 0; n < VE_CLOCKS; n++) {
+		int id = order[n];
+		struct ve_clk *g = &c->clock[id];
+		struct clk_parent_data parent = { .fw_name = "dcxo" };
+		struct clk_init_data init = { .name = names[id], .parent_data = &parent,
+			.num_parents = 1, .flags = CLK_GET_RATE_NOCACHE };
+		g->ccu = c; g->id = id; g->mask = masks[id];
+		g->reg = id < 2 ? c->ve + 4 * id : ve_shared(pdev, regs[id]);
+		if (IS_ERR(g->reg)) return PTR_ERR(g->reg);
+		init.ops = id == VE_CORE ? &ve_core_ops :
+			(id == VE_PERI800 ? &ve_parent_ops : &ve_gate_ops);
+		if (id == VE_CORE) { parent.fw_name = NULL; parent.hw = &c->clock[VE_PERI800].hw; }
+		else if (id == 1 || id == 2 || id == 5) parent.fw_name = "ahb";
+		else if (id != VE_PERI800) parent.fw_name = "mbus";
+		g->hw.init = &init;
+		ret = devm_clk_hw_register(dev, &g->hw);
+		if (ret) return ret;
+		c->clocks->hws[id] = &g->hw;
+	}
+	c->reset.owner = THIS_MODULE; c->reset.ops = &ve_reset_ops;
+	c->reset.nr_resets = 1; c->reset.of_node = dev->of_node;
+	ret = devm_reset_controller_register(dev, &c->reset);
+	if (ret) return ret;
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, c->clocks);
+}
+static const struct of_device_id ve_ccu_match[] = {
+	{ .compatible = "allwinner,t736-ve-ccu" }, { }
+};
+static struct platform_driver ve_ccu_driver = {
+	.probe = ve_ccu_probe,
+	.driver = { .name = "t736-ve-ccu", .of_match_table = ve_ccu_match,
+		.suppress_bind_attrs = true },
+};
+builtin_platform_driver(ve_ccu_driver);
