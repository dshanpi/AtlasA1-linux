@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/ {
+	/* Exclusive byte-mode owner of the PMIC bus; only DCDC5 is exposed. */
+	gpu_dcdc5: regulator@7083000 {
+		compatible = "allwinner,t736-gpu-supply";
+		reg = <0 0x07083000 0 0x400>, <0 0x07010010 0 4>,
+		      <0 0x0701019c 0 4>, <0 0x07025000 0 4>;
+		reg-names = "twi", "apbs1", "twi-gate", "pins";
+		regulator-name = "axp8191-gpu-dcdc5";
+		regulator-min-microvolt = <800000>;
+		regulator-max-microvolt = <960000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+};
diff --git a/arch/arm64/boot/dts/allwinner/t736-gpu.dtsi b/arch/arm64/boot/dts/allwinner/t736-gpu.dtsi
new file mode 100644
index 0000000000000000000000000000000000000000..a544d5e2df187a511af452dcee3041b60517f793
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/t736-gpu.dtsi
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Fixed LPDDR4x T736 board GPU, independent from Radxa LPDDR5 device trees.
+ * Include after t736-hdmi.dtsi and the real AXP8191 gpu_dcdc5 provider.
+ * Clock IDs: core=0, bus=1, measured PERI400=2, AHB=3, MBUS=4, PLL_GPU0=5.
+ * DDK contract: DVFS/ActivePM disabled, no direct GPU_CORE PPU writes.
+ */
+/ {
+	gpu_ccu: clock-controller@2002b20 {
+		compatible = "allwinner,t736-gpu-ccu";
+		reg = <0 0x02002b20 0 8>, <0 0x02002000 0 4>,
+		      <0 0x020020a0 0 4>, <0 0x020025c0 0 4>,
+		      <0 0x020025e0 0 4>, <0 0x020020e0 0 4>;
+		reg-names = "gpu", "pll-ref", "pll-peri0", "ahb-master", "mbus-master", "pll-gpu0";
+		clocks = <&dcxo>, <&ahb_fw>, <&mbus_fw>;
+		clock-names = "dcxo", "ahb", "mbus";
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+
+	gpu_pd: power-controller@7065000 {
+		compatible = "allwinner,t736-gpu-power";
+		reg = <0 0x07065000 0 0x1000>, <0 0x07066000 0 0x1000>;
+		reg-names = "top", "core";
+		clocks = <&gpu_ccu 5>, <&display_ccu 11>, <&gpu_ccu 3>, <&gpu_ccu 4>,
+			 <&gpu_ccu 1>, <&gpu_ccu 0>;
+		clock-names = "pll-gpu0", "ppu", "ahb", "mbus", "gpu-bus", "gpu";
+		resets = <&gpu_ccu 0>;
+		reset-names = "reset_bus";
+		gpu-supply = <&gpu_dcdc5>;
+		#power-domain-cells = <1>;
+	};
+
+	gpu: gpu@1800000 {
+		compatible = "img,gpu";
+		reg = <0 0x01800000 0 0x8ffff>;
+		interrupts = <0 63 4>;
+		interrupt-names = "IRQGPU";
+		clocks = <&gpu_ccu 0>, <&gpu_ccu 1>, <&gpu_ccu 2>;
+		clock-names = "clk", "clk_bus", "clk_400";
+		resets = <&gpu_ccu 0>;
+		reset-names = "reset_bus";
+		power-domains = <&gpu_pd 0>;
+		gpu-supply = <&gpu_dcdc5>;
+		clk_rate = <400000000>;
+		status = "disabled";
+	};
+};
diff --git a/arch/arm64/boot/dts/allwinner/t736-hdmi-candidate.dts b/arch/arm64/boot/dts/allwinner/t736-hdmi-candidate.dts
new file mode 100644
index 0000000000000000000000000000000000000000..f9fa008ff8607a99b649744a246e1c75af4ad314
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/t736-hdmi-candidate.dts
@@ -0,0 +1,291 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+
+/memreserve/ 0x48000000 0x01000000;
+/memreserve/ 0xb4613000 0x003e8000;
+/memreserve/ 0xb8800000 0x07800000;
+/memreserve/ 0xfb800000 0x04800000;
+
+/ {
+	model = "T736 custom board mainline bring-up";
+	compatible = "allwinner,t736";
+	#address-cells = <2>;
+	#size-cells = <2>;
+	interrupt-parent = <&gic>;
+
+	aliases { serial0 = &uart0; mmc0 = &mmc0; };
+	chosen { stdout-path = "serial0:115200n8"; };
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 2 0>;
+	};
+
+	cpus {
+		#address-cells = <2>;
+		#size-cells = <0>;
+		cpu@0 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x000>; enable-method = "psci"; };
+		cpu@100 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x100>; enable-method = "psci"; };
+		cpu@200 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x200>; enable-method = "psci"; };
+		cpu@300 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x300>; enable-method = "psci"; };
+		cpu@400 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x400>; enable-method = "psci"; };
+		cpu@500 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x500>; enable-method = "psci"; };
+		cpu@600 { device_type = "cpu"; compatible = "arm,cortex-a76"; reg = <0 0x600>; enable-method = "psci"; };
+		cpu@700 { device_type = "cpu"; compatible = "arm,cortex-a76"; reg = <0 0x700>; enable-method = "psci"; };
+	};
+
+	psci { compatible = "arm,psci-1.0"; method = "smc"; };
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupts = <1 13 8>, <1 14 8>, <1 11 8>, <1 10 8>;
+	};
+
+	gic: interrupt-controller@3400000 {
+		compatible = "arm,gic-v3";
+		#interrupt-cells = <3>;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		interrupt-controller;
+		reg = <0 0x03400000 0 0x10000>,
+		      <0 0x03460000 0 0x100000>;
+	};
+
+	osc24m: osc24m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	dcxo: dcxo {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <26000000>;
+	};
+
+	osc32k: osc32k {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	/* The R-APB gate and bank voltages remain initialized by firmware.
+	 * osc24m is a temporary APB clock handle, not a measured bus rate.
+	 */
+	r_pio: pinctrl@7025000 {
+		compatible = "allwinner,t736-r-pinctrl";
+		reg = <0 0x07025000 0 0x410>;
+		interrupts = <0 198 4>, <0 200 4>;
+		clocks = <&osc24m>, <&dcxo>, <&osc32k>;
+		clock-names = "apb", "hosc", "losc";
+		gpio-controller;
+		#gpio-cells = <3>;
+		interrupt-controller;
+		#interrupt-cells = <3>;
+		#address-cells = <0>;
+	};
+
+	usb1_vbus: regulator-usb1-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb1-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&r_pio 0 6 0>;
+		enable-active-high;
+		startup-delay-us = <1000>;
+	};
+
+	/* Separate resources avoid the eMMC driver's CCU register subset. */
+	usb_ccu: clock-controller@2003300 {
+		compatible = "allwinner,t736-usb-ccu";
+		reg = <0 0x02003300 0 0x50>, <0 0x020025a4 0 4>,
+		      <0 0x020025c0 0 4>;
+		clocks = <&osc24m>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+
+	usb1_phy: phy@4200800 {
+		compatible = "allwinner,t736-usb1-phy";
+		reg = <0 0x04200800 0 0x20>;
+		clocks = <&usb_ccu 0>, <&usb_ccu 1>, <&usb_ccu 5>, <&usb_ccu 4>;
+		clock-names = "ref", "bus", "master", "msi";
+		resets = <&usb_ccu 0>;
+		#phy-cells = <0>;
+		vbus-supply = <&usb1_vbus>;
+		allwinner,phy-tuning = <0x188>;
+	};
+
+	ehci1: usb@4200000 {
+		compatible = "generic-ehci";
+		reg = <0 0x04200000 0 0x400>;
+		interrupts = <0 159 4>;
+		clocks = <&usb_ccu 1>;
+		resets = <&usb_ccu 1>;
+		phys = <&usb1_phy>;
+		phy-names = "usb";
+		companion = <&ohci1>;
+	};
+
+	ohci1: usb@4200400 {
+		compatible = "generic-ohci";
+		reg = <0 0x04200400 0 0x400>;
+		interrupts = <0 160 4>;
+		clocks = <&usb_ccu 2>, <&usb_ccu 3>;
+		resets = <&usb_ccu 2>;
+		phys = <&usb1_phy>;
+		phy-names = "usb";
+	};
+
+	/* Firmware keeps APB0 at 100 MHz and these rails on. No PMIC control yet. */
+	apb0_fw: clock-apb0-firmware {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <100000000>;
+	};
+
+	pc_supply: regulator-pc-firmware {
+		compatible = "regulator-fixed";
+		regulator-name = "pc-1v8-firmware";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	pio: pinctrl@2000000 {
+		compatible = "allwinner,t736-pinctrl";
+		reg = <0 0x02000000 0 0x600>;
+		interrupts = <0 69 4>, <0 71 4>, <0 73 4>, <0 75 4>,
+			     <0 77 4>, <0 79 4>, <0 81 4>, <0 83 4>,
+			     <0 85 4>, <0 87 4>;
+		clocks = <&apb0_fw>, <&dcxo>, <&osc32k>;
+		clock-names = "apb", "hosc", "losc";
+		vcc-pc-supply = <&pc_supply>;
+		gpio-controller;
+		#gpio-cells = <3>;
+		interrupt-controller;
+		#interrupt-cells = <3>;
+		#address-cells = <0>;
+
+		emmc_pins: emmc-pins {
+			pins = "PC0", "PC1", "PC5", "PC6", "PC8", "PC9",
+			       "PC10", "PC11", "PC13", "PC14", "PC15", "PC16";
+			function = "sdc3";
+			allwinner,pinmux = <4>;
+			/* Preserve the firmware's drive strength and pull settings. */
+		};
+	};
+
+	/* Initial PIO driver still owns this CCU subset, but no GPIO registers. */
+	mmc0: mmc@4023000 {
+		compatible = "allwinner,t736-smhc3-pio";
+		reg = <0 0x04023000 0 0x1000>,
+		      <0 0x02002d30 0 4>,
+		      <0 0x02002d3c 0 4>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&emmc_pins>;
+		bus-width = <8>;
+		non-removable;
+	};
+
+	/* Prior firmware keeps UART0 clocks, reset and pinmux configured. */
+	uart0: serial@2500000 {
+		compatible = "snps,dw-apb-uart";
+		reg = <0 0x02500000 0 0x400>;
+		interrupts = <0 2 4>;
+		reg-shift = <2>;
+		reg-io-width = <4>;
+		clocks = <&osc24m>;
+		clock-names = "baudclk";
+		status = "okay";
+	};
+};
+// SPDX-License-Identifier: GPL-2.0-only
+/* Append to the validated PIO board tree for the Ethernet candidate. */
+/ {
+	aliases { ethernet0 = &gmac0; };
+
+	/* Existing firmware configuration, not an independent PLL driver. */
+	ahb_fw: clock-ahb-firmware {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;
+	};
+	pll_peri150_fw: clock-peri150-firmware {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <150000000>;
+	};
+	mbus_fw: clock-mbus-firmware {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <600000000>;
+	};
+	ph_supply: regulator-ph-firmware {
+		compatible = "regulator-fixed";
+		regulator-name = "ph-phy-3v3-firmware";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+	gmac_ccu: clock-controller@2003410 {
+		compatible = "allwinner,t736-gmac-ccu";
+		reg = <0 0x02003410 0 0x10>, <0 0x020025e4 0 4>;
+		clocks = <&ahb_fw>, <&pll_peri150_fw>, <&mbus_fw>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+	gmac0: ethernet@4500000 {
+		compatible = "allwinner,t736-dwmac";
+		reg = <0 0x04500000 0 0x8000>, <0 0x04508000 0 4>;
+		interrupts = <0 172 4>, <0 178 4>, <0 173 4>, <0 174 4>;
+		interrupt-names = "macirq", "eth_lpi", "tx0_irq", "rx0_irq";
+		clocks = <&gmac_ccu 0>, <&gmac_ccu 1>, <&gmac_ccu 2>;
+		clock-names = "stmmaceth", "phy", "mbus";
+		/* stmmac pulses AXI; AHB must stay released for the extension. */
+		resets = <&gmac_ccu 1>, <&gmac_ccu 0>;
+		reset-names = "stmmaceth", "ahb";
+		pinctrl-names = "default";
+		pinctrl-0 = <&gmac0_pins>;
+		phy-mode = "rgmii-rxid";
+		phy-handle = <&gmac0_phy>;
+		phy-supply = <&ph_supply>;
+		max-speed = <1000>;
+		allwinner,tx-delay-taps = <13>;
+		allwinner,rx-delay-taps = <10>;
+		snps,pbl = <8>;
+		snps,aal;
+		/* PHY RX delay is required in addition to the calibrated MAC taps.
+		 * PHY TX delay stays off; all four PHY-delay combinations tested.
+		 */
+		mdio {
+			compatible = "snps,dwmac-mdio";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			/* Release the sole PHY before reading its ID. A child reset
+			 * is only acquired after discovery and cannot bootstrap it.
+			 */
+			reset-gpios = <&pio 7 16 1>;
+			reset-delay-us = <10000>;
+			reset-post-delay-us = <150000>;
+			gmac0_phy: ethernet-phy@1 {
+				reg = <1>;
+			};
+		};
+	};
+};
+
+&pio {
+	vcc-ph-supply = <&ph_supply>;
+	gmac0_pins: gmac0-pins {
+		pins = "PH0", "PH1", "PH2", "PH3", "PH4", "PH5", "PH6", "PH7",
+		       "PH8", "PH9", "PH10", "PH11", "PH12", "PH13", "PH14", "PH15";
+		function = "gmac0";
+		allwinner,pinmux = <5>;
+		/* Match the board's documented RGMII electrical configuration. */
+		drive-strength = <40>;
+		bias-pull-up;
+	};
+};
+
+#include "t736-hdmi.dtsi"
diff --git a/arch/arm64/boot/dts/allwinner/t736-hdmi.dtsi b/arch/arm64/boot/dts/allwinner/t736-hdmi.dtsi
new file mode 100644
index 0000000000000000000000000000000000000000..32ee420a8d12a6a5858fb98b4a0634a45137d4b0
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/t736-hdmi.dtsi
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* T736 DE352 -> VO1/TCON-TV0 -> SNPS HDMI PHY. Requires the source SPL's
+ * verified DLDO2 1.8 V setup. This fragment is for the isolated HDMI candidate.
+ */
+/ {
+	peri300_display: clock-peri300-display {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <300000000>;
+	};
+	display_ccu: clock-controller@2002a00 {
+		compatible = "allwinner,t736-display-ccu";
+		reg = <0 0x02002a00 0 0x78>, <0 0x02003604 0 0xec>,
+		      <0 0x020022e0 0 0x14>, <0 0x02002000 0 4>,
+		      <0 0x020025c0 0 4>, <0 0x020025e0 0 4>,
+		      <0 0x070101ac 0 4>;
+		reg-names = "de", "vo1", "pll-de", "pll-ref", "ahb-master",
+			    "mbus-master", "ppu";
+		clocks = <&osc24m>, <&dcxo>, <&osc32k>, <&ahb_fw>,
+			 <&mbus_fw>, <&peri300_display>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+	display_pd: power-controller@7061000 {
+		compatible = "allwinner,t736-display-power";
+		reg = <0 0x07061000 0 0x1000>, <0 0x0706a000 0 0x1000>;
+		clocks = <&display_ccu 11>;
+		#power-domain-cells = <1>;
+	};
+	hdmi_core_supply: regulator-hdmi-core {
+		compatible = "regulator-fixed";
+		regulator-name = "hdmi-core-dcdc2-board";
+		regulator-min-microvolt = <900000>;
+		regulator-max-microvolt = <900000>;
+		regulator-always-on;
+	};
+	hdmi_1v8_supply: regulator-hdmi-1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "hdmi-1v8-source-spl";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+	sunxi_drm: sunxi-drm {
+		compatible = "allwinner,sunxi-drm";
+		fb_base = <0>;
+	};
+	de: display-engine@5000000 {
+		compatible = "allwinner,display-engine-v352";
+		reg = <0 0x05000000 0 0x400000>;
+		interrupts = <0 50 4>, <0 34 4>;
+		power-domains = <&display_pd 0>;
+		clocks = <&display_ccu 0>, <&display_ccu 1>,
+			 <&display_ccu 2>, <&display_ccu 3>;
+		clock-names = "clk_de", "clk_bus_de", "ahb_vid_out", "mbus_vo_sys";
+		resets = <&display_ccu 0>, <&display_ccu 1>;
+		reset-names = "rst_bus_de", "rst_bus_de_sys";
+		chn_cfg_mode = <2>;
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			port@0 {
+				reg = <0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				de0_to_tv0: endpoint@4 {
+					reg = <4>;
+					remote-endpoint = <&tv0_from_de0>;
+				};
+			};
+		};
+	};
+	vo1: tcon-top@5510000 {
+		compatible = "allwinner,tcon-top1";
+		reg = <0 0x05510000 0 0x1000>;
+		clocks = <&display_ccu 4>, <&display_ccu 5>;
+		clock-names = "clk_bus_dpss_top", "clk_ahb_gate";
+		resets = <&display_ccu 2>, <&display_ccu 3>;
+		reset-names = "rst_bus_dpss_top", "rst_bus_reg";
+		power-domains = <&display_pd 1>;
+	};
+	tv0: tcon@5730000 {
+		compatible = "allwinner,tcon-tv";
+		reg = <0 0x05730000 0 0x1000>;
+		interrupts = <0 57 4>;
+		clocks = <&display_ccu 6>;
+		clock-names = "clk_bus_tcon";
+		resets = <&display_ccu 4>;
+		reset-names = "rst_bus_tcon";
+		top = <&vo1>;
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			port@0 {
+				reg = <0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				tv0_from_de0: endpoint@0 {
+					reg = <0>;
+					remote-endpoint = <&de0_to_tv0>;
+				};
+			};
+			port@1 {
+				reg = <1>;
+				tv0_to_hdmi: endpoint { remote-endpoint = <&hdmi_from_tv0>; };
+			};
+		};
+	};
+	hdmi: hdmi@5520000 {
+		compatible = "allwinner,sunxi-hdmi";
+		reg = <0 0x05520000 0 0x100000>;
+		interrupts = <0 61 4>;
+		power-domains = <&display_pd 1>;
+		clocks = <&display_ccu 7>, <&display_ccu 8>, <&display_ccu 9>,
+			 <&display_ccu 10>, <&dcxo>;
+		clock-names = "clk_cec", "clk_hdmi", "clk_hdmi_24M", "clk_hdcp", "clk_dcxo";
+		resets = <&display_ccu 5>, <&display_ccu 6>, <&display_ccu 7>;
+		reset-names = "rst_bus_sub", "rst_bus_main", "rst_bus_hdcp";
+		dcdc2-supply = <&hdmi_core_supply>;
+		dldo2-supply = <&hdmi_1v8_supply>;
+		hdmi_power0 = "dcdc2";
+		hdmi_power1 = "dldo2";
+		hdmi_power_cnt = <2>;
+		hdmi_hdcp1x_enable = <0>;
+		hdmi_hdcp2x_enable = <0>;
+		hdmi_cec_enable = <0>;
+		hdmi_clock_source = <0>;
+		hdmi_resistor_select = <1>;
+		hdmi_ddc_index = <20>;
+		force-output = <0>;
+		snps_phy = <25000 185625 0x0007 0x8160 0x8188
+			    185625 185625 0x0007 0x8160 0x8198
+			    185625 340000 0x0004 0x8040 0x8e85
+			    340000 600000 0x0000 0x80c0 0x82f6>;
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			port@0 {
+				reg = <0>;
+				hdmi_from_tv0: endpoint { remote-endpoint = <&tv0_to_hdmi>; };
+			};
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/allwinner/t736-mainline-bringup.dts b/arch/arm64/boot/dts/allwinner/t736-mainline-bringup.dts
new file mode 100644
index 0000000000000000000000000000000000000000..02bfe9f5e5871327842982689a19802a91302af2
--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/t736-mainline-bringup.dts
@@ -0,0 +1,289 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+
+/memreserve/ 0x48000000 0x01000000;
+/memreserve/ 0xb4613000 0x003e8000;
+/memreserve/ 0xb8800000 0x07800000;
+/memreserve/ 0xfb800000 0x04800000;
+
+/ {
+	model = "T736 custom board mainline bring-up";
+	compatible = "allwinner,t736";
+	#address-cells = <2>;
+	#size-cells = <2>;
+	interrupt-parent = <&gic>;
+
+	aliases { serial0 = &uart0; mmc0 = &mmc0; };
+	chosen { stdout-path = "serial0:115200n8"; };
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 2 0>;
+	};
+
+	cpus {
+		#address-cells = <2>;
+		#size-cells = <0>;
+		cpu@0 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x000>; enable-method = "psci"; };
+		cpu@100 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x100>; enable-method = "psci"; };
+		cpu@200 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x200>; enable-method = "psci"; };
+		cpu@300 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x300>; enable-method = "psci"; };
+		cpu@400 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x400>; enable-method = "psci"; };
+		cpu@500 { device_type = "cpu"; compatible = "arm,cortex-a55"; reg = <0 0x500>; enable-method = "psci"; };
+		cpu@600 { device_type = "cpu"; compatible = "arm,cortex-a76"; reg = <0 0x600>; enable-method = "psci"; };
+		cpu@700 { device_type = "cpu"; compatible = "arm,cortex-a76"; reg = <0 0x700>; enable-method = "psci"; };
+	};
+
+	psci { compatible = "arm,psci-1.0"; method = "smc"; };
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupts = <1 13 8>, <1 14 8>, <1 11 8>, <1 10 8>;
+	};
+
+	gic: interrupt-controller@3400000 {
+		compatible = "arm,gic-v3";
+		#interrupt-cells = <3>;
+		#address-cells = <2>;
+		#size-cells = <2>;
+		interrupt-controller;
+		reg = <0 0x03400000 0 0x10000>,
+		      <0 0x03460000 0 0x100000>;
+	};
+
+	osc24m: osc24m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	dcxo: dcxo {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <26000000>;
+	};
+
+	osc32k: osc32k {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	/* The R-APB gate and bank voltages remain initialized by firmware.
+	 * osc24m is a temporary APB clock handle, not a measured bus rate.
+	 */
+	r_pio: pinctrl@7025000 {
+		compatible = "allwinner,t736-r-pinctrl";
+		reg = <0 0x07025000 0 0x410>;
+		interrupts = <0 198 4>, <0 200 4>;
+		clocks = <&osc24m>, <&dcxo>, <&osc32k>;
+		clock-names = "apb", "hosc", "losc";
+		gpio-controller;
+		#gpio-cells = <3>;
+		interrupt-controller;
+		#interrupt-cells = <3>;
+		#address-cells = <0>;
+	};
+
+	usb1_vbus: regulator-usb1-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb1-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&r_pio 0 6 0>;
+		enable-active-high;
+		startup-delay-us = <1000>;
+	};
+
+	/* Separate resources avoid the eMMC driver's CCU register subset. */
+	usb_ccu: clock-controller@2003300 {
+		compatible = "allwinner,t736-usb-ccu";
+		reg = <0 0x02003300 0 0x50>, <0 0x020025a4 0 4>,
+		      <0 0x020025c0 0 4>;
+		clocks = <&osc24m>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+
+	usb1_phy: phy@4200800 {
+		compatible = "allwinner,t736-usb1-phy";
+		reg = <0 0x04200800 0 0x20>;
+		clocks = <&usb_ccu 0>, <&usb_ccu 1>, <&usb_ccu 5>, <&usb_ccu 4>;
+		clock-names = "ref", "bus", "master", "msi";
+		resets = <&usb_ccu 0>;
+		#phy-cells = <0>;
+		vbus-supply = <&usb1_vbus>;
+		allwinner,phy-tuning = <0x188>;
+	};
+
+	ehci1: usb@4200000 {
+		compatible = "generic-ehci";
+		reg = <0 0x04200000 0 0x400>;
+		interrupts = <0 159 4>;
+		clocks = <&usb_ccu 1>;
+		resets = <&usb_ccu 1>;
+		phys = <&usb1_phy>;
+		phy-names = "usb";
+		companion = <&ohci1>;
+	};
+
+	ohci1: usb@4200400 {
+		compatible = "generic-ohci";
+		reg = <0 0x04200400 0 0x400>;
+		interrupts = <0 160 4>;
+		clocks = <&usb_ccu 2>, <&usb_ccu 3>;
+		resets = <&usb_ccu 2>;
+		phys = <&usb1_phy>;
+		phy-names = "usb";
+	};
+
+	/* Firmware keeps APB0 at 100 MHz and these rails on. No PMIC control yet. */
+	apb0_fw: clock-apb0-firmware {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <100000000>;
+	};
+
+	pc_supply: regulator-pc-firmware {
+		compatible = "regulator-fixed";
+		regulator-name = "pc-1v8-firmware";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	pio: pinctrl@2000000 {
+		compatible = "allwinner,t736-pinctrl";
+		reg = <0 0x02000000 0 0x600>;
+		interrupts = <0 69 4>, <0 71 4>, <0 73 4>, <0 75 4>,
+			     <0 77 4>, <0 79 4>, <0 81 4>, <0 83 4>,
+			     <0 85 4>, <0 87 4>;
+		clocks = <&apb0_fw>, <&dcxo>, <&osc32k>;
+		clock-names = "apb", "hosc", "losc";
+		vcc-pc-supply = <&pc_supply>;
+		gpio-controller;
+		#gpio-cells = <3>;
+		interrupt-controller;
+		#interrupt-cells = <3>;
+		#address-cells = <0>;
+
+		emmc_pins: emmc-pins {
+			pins = "PC0", "PC1", "PC5", "PC6", "PC8", "PC9",
+			       "PC10", "PC11", "PC13", "PC14", "PC15", "PC16";
+			function = "sdc3";
+			allwinner,pinmux = <4>;
+			/* Preserve the firmware's drive strength and pull settings. */
+		};
+	};
+
+	/* Initial PIO driver still owns this CCU subset, but no GPIO registers. */
+	mmc0: mmc@4023000 {
+		compatible = "allwinner,t736-smhc3-pio";
+		reg = <0 0x04023000 0 0x1000>,
+		      <0 0x02002d30 0 4>,
+		      <0 0x02002d3c 0 4>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&emmc_pins>;
+		bus-width = <8>;
+		non-removable;
+	};
+
+	/* Prior firmware keeps UART0 clocks, reset and pinmux configured. */
+	uart0: serial@2500000 {
+		compatible = "snps,dw-apb-uart";
+		reg = <0 0x02500000 0 0x400>;
+		interrupts = <0 2 4>;
+		reg-shift = <2>;
+		reg-io-width = <4>;
+		clocks = <&osc24m>;
+		clock-names = "baudclk";
+		status = "okay";
+	};
+};
+// SPDX-License-Identifier: GPL-2.0-only
+/* Append to the validated PIO board tree for the Ethernet candidate. */
+/ {
+	aliases { ethernet0 = &gmac0; };
+
+	/* Existing firmware configuration, not an independent PLL driver. */
+	ahb_fw: clock-ahb-firmware {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;
+	};
+	pll_peri150_fw: clock-peri150-firmware {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <150000000>;
+	};
+	mbus_fw: clock-mbus-firmware {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <600000000>;
+	};
+	ph_supply: regulator-ph-firmware {
+		compatible = "regulator-fixed";
+		regulator-name = "ph-phy-3v3-firmware";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+	gmac_ccu: clock-controller@2003410 {
+		compatible = "allwinner,t736-gmac-ccu";
+		reg = <0 0x02003410 0 0x10>, <0 0x020025e4 0 4>;
+		clocks = <&ahb_fw>, <&pll_peri150_fw>, <&mbus_fw>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+	gmac0: ethernet@4500000 {
+		compatible = "allwinner,t736-dwmac";
+		reg = <0 0x04500000 0 0x8000>, <0 0x04508000 0 4>;
+		interrupts = <0 172 4>, <0 178 4>, <0 173 4>, <0 174 4>;
+		interrupt-names = "macirq", "eth_lpi", "tx0_irq", "rx0_irq";
+		clocks = <&gmac_ccu 0>, <&gmac_ccu 1>, <&gmac_ccu 2>;
+		clock-names = "stmmaceth", "phy", "mbus";
+		/* stmmac pulses AXI; AHB must stay released for the extension. */
+		resets = <&gmac_ccu 1>, <&gmac_ccu 0>;
+		reset-names = "stmmaceth", "ahb";
+		pinctrl-names = "default";
+		pinctrl-0 = <&gmac0_pins>;
+		phy-mode = "rgmii-rxid";
+		phy-handle = <&gmac0_phy>;
+		phy-supply = <&ph_supply>;
+		max-speed = <1000>;
+		allwinner,tx-delay-taps = <13>;
+		allwinner,rx-delay-taps = <10>;
+		snps,pbl = <8>;
+		snps,aal;
+		/* PHY RX delay is required in addition to the calibrated MAC taps.
+		 * PHY TX delay stays off; all four PHY-delay combinations tested.
+		 */
+		mdio {
+			compatible = "snps,dwmac-mdio";
+			#address-cells = <1>;
+			#size-cells = <0>;
+			/* Release the sole PHY before reading its ID. A child reset
+			 * is only acquired after discovery and cannot bootstrap it.
+			 */
+			reset-gpios = <&pio 7 16 1>;
+			reset-delay-us = <10000>;
+			reset-post-delay-us = <150000>;
+			gmac0_phy: ethernet-phy@1 {
+				reg = <1>;
+			};
+		};
+	};
+};
+
+&pio {
+	vcc-ph-supply = <&ph_supply>;
+	gmac0_pins: gmac0-pins {
+		pins = "PH0", "PH1", "PH2", "PH3", "PH4", "PH5", "PH6", "PH7",
+		       "PH8", "PH9", "PH10", "PH11", "PH12", "PH13", "PH14", "PH15";
+		function = "gmac0";
+		allwinner,pinmux = <5>;
+		/* Match the board's documented RGMII electrical configuration. */
+		drive-strength = <40>;
+		bias-pull-up;
+	};
+};
diff --git a/arch/arm64/boot/dts/allwinner/t736-media-v27.dtsi b/arch/arm64/boot/dts/allwinner/t736-media-v27.dtsi
