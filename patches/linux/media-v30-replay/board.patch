+	.bank_offset = 0x80,
+	.bank_stride = 0x80,
+	.drive_offset = 0x20,
+	.drive_width = 4,
+	.pull_offset = 0x30,
+	.irq_offset = 0xc0,
+	.irq_stride = 0x80,
+};
+static struct sunxi_pinctrl_desc t736_desc = {
