+		clocks = <0x1f 0x05 0x16 0x0b 0x1f 0x03 0x1f 0x04 0x1f 0x01 0x1f 0x00>;
+		clock-names = "pll-gpu0", "ppu", "ahb", "mbus", "gpu-bus", "gpu";
+		resets = <0x1f 0x00>;
+		reset-names = "reset_bus";
+		gpu-supply = <0x20>;
+		#power-domain-cells = <0x01>;
+		phandle = <0x21>;
+	};
+
+	gpu@1800000 {
+		compatible = "img,gpu";
+		reg = <0x00 0x1800000 0x00 0x8ffff>;
+		interrupts = <0x00 0x3f 0x04>;
+		interrupt-names = "IRQGPU";
+		clocks = <0x1f 0x00 0x1f 0x01 0x1f 0x02>;
+		clock-names = "clk", "clk_bus", "clk_400";
+		resets = <0x1f 0x00>;
+		reset-names = "reset_bus";
+		power-domains = <0x21 0x00>;
+		gpu-supply = <0x20>;
+		clk_rate = <0x17d78400>;
+		status = "okay";
+	};
+};
+
+// SPDX-License-Identifier: GPL-2.0-only
+/* CPU scheduling metadata only; not included by any production build.
+ * Source: Tina bsp/configs/linux-6.6/sun60iw2p1.dtsi, lines 125-299.
+ * Donor SHA256: d68616db1d2755fbf13730d34e1edadb474cf7e5deb93ca982295b6e2a5edba4
+ * A55/A76 fixed-frequency baseline is 1014 MHz on both clusters.
+ * No CPU clock, OPP, voltage, idle-state or frequency-control provider added.
+ */
+/ {
+	cpus {
+		t736_sched_cpu0: cpu@0 { capacity-dmips-mhz = <430>; };
+		t736_sched_cpu1: cpu@100 { capacity-dmips-mhz = <430>; };
+		t736_sched_cpu2: cpu@200 { capacity-dmips-mhz = <430>; };
+		t736_sched_cpu3: cpu@300 { capacity-dmips-mhz = <430>; };
+		t736_sched_cpu4: cpu@400 { capacity-dmips-mhz = <430>; };
+		t736_sched_cpu5: cpu@500 { capacity-dmips-mhz = <430>; };
+		t736_sched_cpu6: cpu@600 { capacity-dmips-mhz = <1024>; };
+		t736_sched_cpu7: cpu@700 { capacity-dmips-mhz = <1024>; };
+
+		cpu-map {
+			cluster0 {
+				core0 { cpu = <&t736_sched_cpu0>; };
+				core1 { cpu = <&t736_sched_cpu1>; };
+				core2 { cpu = <&t736_sched_cpu2>; };
+				core3 { cpu = <&t736_sched_cpu3>; };
+				core4 { cpu = <&t736_sched_cpu4>; };
+				core5 { cpu = <&t736_sched_cpu5>; };
+			};
+			cluster1 {
+				core0 { cpu = <&t736_sched_cpu6>; };
+				core1 { cpu = <&t736_sched_cpu7>; };
+			};
+		};
+	};
+};
+
+// SPDX-License-Identifier: GPL-2.0-only
+/* Fixed-board HS SDR parent observation: no shared PLL ownership or writes. */
+&{/mmc@4023000} {
+	reg = <0 0x04023000 0 0x1000>, <0 0x02002d30 0 4>,
+	      <0 0x02002d3c 0 4>, <0 0x020025e0 0 4>,
+	      <0 0x0200259c 0 4>, <0 0x02002000 0 4>,
+	      <0 0x020020a0 0 0x10>;
+	clocks = <&{/dcxo}>;
+	clock-names = "dcxo";
