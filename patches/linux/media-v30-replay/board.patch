diff --git a/drivers/soc/sunxi/t736-ve-power.c b/drivers/soc/sunxi/t736-ve-power.c
new file mode 100644
index 0000000000000000000000000000000000000000..6dbc4710826c30fb65dfa1d55d6cd94efea3a6e3
--- /dev/null
+++ b/drivers/soc/sunxi/t736-ve-power.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Decoder PCK600 + only DEC0/DEC1 IOMMU bypass. Experimental always-on
+ * provider for a private, physically contiguous, 32-bit WC DMA heap.
+ * Never asserts IOMMU1 reset or alters its global translation/TTB state.
+ */
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/reset.h>
+
+struct ve_power {
+	struct device *dev;
+	struct generic_pm_domain genpd;
+	struct clk_bulk_data clocks[8];
+	void __iomem *ppu, *bypass[2];
+};
+
+static int ve_power_on(struct generic_pm_domain *domain)
+{
+	struct ve_power *p = container_of(domain, struct ve_power, genpd);
+	u32 v;
+	int i, ret;
+
+	writel((readl(p->ppu) & ~0xf) | 8, p->ppu);
+	ret = readl_poll_timeout(p->ppu + 8, v, (v & 0xf) == 8, 10, 10000);
+	if (ret) {
+		dev_err(p->dev, "VE_DEC PPU ON timeout: %08x\n", v);
+		return ret;
+	}
+	/* MIC6 and MIC7 are physically in the decoder domain. */
+	for (i = 0; i < ARRAY_SIZE(p->bypass); i++) {
+		v = readl(p->bypass[i]);
+		writel(v | BIT(0), p->bypass[i]);
+		if (readl(p->bypass[i]) != (v | BIT(0)))
+			return -EIO;
+	}
+	return 0;
+}
+
+static int ve_power_probe(struct platform_device *pdev)
+{
+	static const char * const names[] = { "ppu", "ahb", "mbus-master",
+		"mbus", "bus", "iommu1-mbus", "iommu1-sys", "ve" };
+	struct device *dev = &pdev->dev;
+	struct ve_power *p;
+	struct reset_control *reset;
+	int i, ret;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p) return -ENOMEM;
+	p->dev = dev;
+	p->ppu = devm_platform_ioremap_resource_byname(pdev, "ppu");
+	p->bypass[0] = devm_platform_ioremap_resource_byname(pdev, "dec0-bypass");
+	p->bypass[1] = devm_platform_ioremap_resource_byname(pdev, "dec1-bypass");
+	if (IS_ERR(p->ppu)) return PTR_ERR(p->ppu);
+	for (i = 0; i < ARRAY_SIZE(p->bypass); i++)
+		if (IS_ERR(p->bypass[i])) return PTR_ERR(p->bypass[i]);
+	for (i = 0; i < ARRAY_SIZE(p->clocks); i++) p->clocks[i].id = names[i];
+	ret = devm_clk_bulk_get(dev, ARRAY_SIZE(p->clocks), p->clocks);
+	if (ret) return dev_err_probe(dev, ret, "missing decoder clocks\n");
+	reset = reset_control_get_exclusive(dev, "ve");
+	if (IS_ERR(reset)) return PTR_ERR(reset);
+	/* Pin all bus/core references before publishing this built-in domain.
+	 * An error retains any requested PPU ON state; no consumer was exposed.
+	 */
+	ret = reset_control_assert(reset);
+	if (ret) goto put_reset;
+	ret = clk_bulk_prepare_enable(ARRAY_SIZE(p->clocks), p->clocks);
+	if (ret) goto put_reset;
+	if (clk_get_rate(p->clocks[7].clk) != 400000000) {
+		ret = -ERANGE;
+		goto disable_clocks;
+	}
+	writel(0x1f1f1f, p->ppu + 0x170);
+	writel(0x1f1f, p->ppu + 0x174);
+	writel(0x08080808, p->ppu + 0xc00);
+	writel(0x808, p->ppu + 0xc04);
+	writel(8, p->ppu + 0xc10);
+	p->genpd.name = "t736-ve-dec";
+	p->genpd.flags = GENPD_FLAG_ALWAYS_ON;
+	p->genpd.power_on = ve_power_on;
+	ret = ve_power_on(&p->genpd);
+	if (ret) goto disable_clocks;
+	ret = pm_genpd_init(&p->genpd, NULL, false);
+	if (ret) goto disable_clocks;
+	/* Leave decoder reset asserted. Its sole consumer owns deassert/start. */
+	ret = reset_control_status(reset);
+	if (ret != 1) {
+		ret = ret < 0 ? ret : -EIO;
+		goto remove_domain;
+	}
+	reset_control_put(reset);
+	reset = NULL;
+	ret = of_genpd_add_provider_simple(dev->of_node, &p->genpd);
+	if (ret) goto remove_domain;
+	dev_info(dev, "VE_DEC PPU=ON, 400MHz, DEC0/1 bypass verified; reset held\n");
+	return 0;
+remove_domain:
+	pm_genpd_remove(&p->genpd);
+disable_clocks:
+	clk_bulk_disable_unprepare(ARRAY_SIZE(p->clocks), p->clocks);
+put_reset:
+	reset_control_put(reset);
+	return dev_err_probe(dev, ret, "decoder power bootstrap failed\n");
+}
+
+static const struct of_device_id ve_power_match[] = {
+	{ .compatible = "allwinner,t736-ve-power" }, { }
+};
+static struct platform_driver ve_power_driver = {
+	.probe = ve_power_probe,
+	.driver = { .name = "t736-ve-power", .of_match_table = ve_power_match,
+		.suppress_bind_attrs = true },
+};
+builtin_platform_driver(ve_power_driver);
diff --git a/include/linux/t736-pmic.h b/include/linux/t736-pmic.h
new file mode 100644
index 0000000000000000000000000000000000000000..5492dc32b70fe37a2b331dcfd7fa87518ce6cb20
--- /dev/null
+++ b/include/linux/t736-pmic.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_T736_PMIC_H
+#define _LINUX_T736_PMIC_H
+
+#include <linux/types.h>
+
+/**
+ * struct t736_cpu_supply_snapshot - raw AXP8191 CPU supply registers
+ * @id: chip ID, register 0x0e (expected 3)
+ * @enable: DCDC enable bits, register 0x10 (DCDC3 bit 2, DCDC4 bit 3)
+ * @dcdc3: A55/DSU voltage selector and DVM bit, register 0x14
+ * @dcdc4: A76 voltage selector and DVM bit, register 0x15
+ * @phase: poly-phase configuration, register 0x1b
+ * @feedback: remote-feedback configuration, register 0x1d
+ *
+ * DCDC3/4 selectors are bits 6:0; bit 7 is DVM, not a voltage bit.
+ * Selectors 0..0x46 encode 500000 + selector * 10000 microvolts;
+ * selectors 0x47..0x57 encode 1220000 + (selector - 0x47) * 20000.
+ * Larger selectors are reserved. Phase bits 6/7 join DCDC2/3 and DCDC4/5.
+ */
+struct t736_cpu_supply_snapshot {
+	u8 id;
+	u8 enable;
+	u8 dcdc3;
+	u8 dcdc4;
+	u8 phase;
+	u8 feedback;
+};
+
+/**
+ * t736_pmic_read_cpu_supplies - read CPU rails through the existing bus owner
+ * @snapshot: receives all six raw registers on success; unchanged on failure
+ *
+ * Sleepable context only. Serializes with the GPU regulator using its existing
+ * bus mutex. Does not initialize the bus, write PMIC data, or change supplies.
+ * Register reads necessarily issue TWI control writes and PMIC address bytes.
+ * The readings are sequential under one lock, not simultaneous ADC samples.
+ * Callers must validate enable, phase, and selector values before using them.
+ *
+ * Return: 0 on success, -EINVAL for NULL, -ENODEV before successful owner probe
+ * or for a chip ID mismatch, or a negative transaction error. The API is
+ * GPL-only; it is absent from kernels predating this board-specific interface.
+ */
+int t736_pmic_read_cpu_supplies(struct t736_cpu_supply_snapshot *snapshot);
+
+#endif
