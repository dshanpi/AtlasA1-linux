+/*
+ * AXP8191 DLDO5 supplies the PG and PM pads and WLAN VIO. The stock
+ * board's 1.8 V configuration uses selector 13 (500 mV + 13 * 100 mV).
+ * The enable register also contains ELDO1, the live LPDDR4x VDDQ rail.
+ */
+#define DLDO5_ENABLE_REG 0x22
+#define DLDO5_ENABLE BIT(4)
+#define DLDO5_VOLTAGE_REG 0x38
+#define DLDO5_VSEL GENMASK(4, 0)
+#define DLDO5_1V8 13
+
+static int dldo5_enable_1v8(struct t736_gpu_supply *p)
+{
+	u8 enable, voltage, dcdc_enable, dcdc1;
+	int ret;
+
+	mutex_lock(&p->lock);
+	ret = pmic_read(p, 0x10, &dcdc_enable);
+	if (!ret)
+		ret = pmic_read(p, 0x12, &dcdc1);
+	if (!ret)
+		ret = pmic_read(p, DLDO5_ENABLE_REG, &enable);
+	if (!ret)
+		ret = pmic_read(p, DLDO5_VOLTAGE_REG, &voltage);
+	if (ret)
+		goto out;
+
+	if (!(dcdc_enable & BIT(0)) || (dcdc1 & 0x1f) != 23 ||
+	    (voltage & DLDO5_VSEL) > 29) {
+		ret = -ERANGE;
+		goto out;
+	}
+	if (enable & DLDO5_ENABLE) {
+		ret = (voltage & DLDO5_VSEL) == DLDO5_1V8 ? 0 : -ERANGE;
+		goto out;
+	}
+	if ((voltage & DLDO5_VSEL) != DLDO5_1V8) {
+		ret = pmic_write_checked(p, DLDO5_VOLTAGE_REG,
+					 (voltage & ~DLDO5_VSEL) | DLDO5_1V8);
+		if (ret)
+			goto out;
+	}
+	ret = pmic_write_checked(p, DLDO5_ENABLE_REG, enable | DLDO5_ENABLE);
+	if (!ret) {
+		usleep_range(1000, 1500);
+		dev_info(p->dev, "DLDO5 1800000 uV: voltage %02x->%02x enable %02x->%02x\n",
+			 voltage, (u8)((voltage & ~DLDO5_VSEL) | DLDO5_1V8),
+			 enable, (u8)(enable | DLDO5_ENABLE));
+	}
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+
+static int dldo5_enable(struct regulator_dev *rdev)
+{
+	return dldo5_enable_1v8(rdev_get_drvdata(rdev));
+}
+
+static int dldo5_is_enabled(struct regulator_dev *rdev)
+{
+	struct t736_gpu_supply *p = rdev_get_drvdata(rdev);
+	u8 value;
+	int ret;
+
+	mutex_lock(&p->lock);
+	ret = pmic_read(p, DLDO5_ENABLE_REG, &value);
+	mutex_unlock(&p->lock);
+	return ret ? ret : !!(value & DLDO5_ENABLE);
+}
+
+static const struct regulator_ops dldo5_ops = {
+	.enable = dldo5_enable,
+	.is_enabled = dldo5_is_enabled,
+};
+
+static const struct regulator_desc dldo5_desc = {
+	.name = "t736-axp8191-dldo5",
+	.owner = THIS_MODULE,
+	.type = REGULATOR_VOLTAGE,
+	.ops = &dldo5_ops,
+	.n_voltages = 1,
+	.fixed_uV = 1800000,
+};
+
+static int register_wireless_io(struct t736_gpu_supply *p)
+{
+	struct device_node *node __free(device_node) =
+		of_get_child_by_name(p->dev->of_node, "regulator-dldo5");
+	struct regulator_config conf = { .dev = p->dev, .of_node = node, .driver_data = p };
+	int ret;
+
+	if (!node)
+		return 0;
+
+	conf.init_data = of_get_regulator_init_data(p->dev, node, &dldo5_desc);
+	if (!conf.init_data)
+		return -EINVAL;
+	ret = dldo5_enable_1v8(p);
+	if (ret)
+		return ret;
+	return PTR_ERR_OR_ZERO(devm_regulator_register(p->dev, &dldo5_desc, &conf));
+}
+
 static int gpu_supply_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
