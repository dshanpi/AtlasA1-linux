+// SPDX-License-Identifier: GPL-2.0-only
+#include "t736-gpu-candidate.dts"
+
+&{/pinctrl@2000000} {
+	/* SWOUT1 feeds PH (RP447) and PI (RP337) on the AtlasA1 core. */
+	vcc-pi-supply = <&{/regulator-ph-firmware}>;
+};
+
+/ {
+	pcie_power: power-controller@7067000 {
+		compatible = "allwinner,t736-pcie-power";
+		reg = <0 0x07067000 0 0x1000>;
+		clocks = <&{/clock-controller@2002a00} 11>;
+		#power-domain-cells = <1>;
+	};
+
+	pcie@6000000 {
+		compatible = "allwinner,t736-pcie";
+		device_type = "pci";
+		#address-cells = <3>;
+		#size-cells = <2>;
+		reg = <0 0x06000000 0 0x100000>, <0 0x06100000 0 0x40000>,
+		      <0 0x06300000 0 0x80000>, <0 0x06380000 0 0x80000>,
+		      <0 0x06400000 0 0x80000>, <0 0x20000000 0 0x1000000>,
+		      <0 0x06c02000 0 0xa00>, <0 0x06ca0000 0 0x20000>,
+		      <0 0x0200338c 0 4>, <0 0x02002574 0 4>,
+		      <0 0x02003380 0 4>, <0 0x02003384 0 4>,
+		      <0 0x020033c0 0 4>, <0 0x0709016c 0 4>,
+		      <0 0x020033c4 0 4>, <0 0x06c00004 0 4>,
+		      <0 0x06c000f0 0 4>, <0 0x06c06c44 0 4>;
+		reg-names = "dbi", "dbi2", "atu", "dma", "app", "config",
+			    "combo", "pma", "pcie-reset", "its", "aux", "axi",
+			    "serdes-cfg", "serdes-dcxo", "serdes-reset",
+			    "serdes-gates", "serdes-debug", "pipe-mode";
+		power-domains = <&pcie_power 0>;
+		clocks = <&{/clock-controller@2002b20} 2>;
+		clock-names = "peri400";
+		reset-gpios = <&{/pinctrl@2000000} 8 10 1>;
+		bus-range = <0 255>;
+		linux,pci-domain = <0>;
+		num-lanes = <1>;
+		max-link-speed = <1>;
+		ranges = <0x01000000 0 0x21000000 0 0x21000000 0 0x01000000>,
+			 <0x02000000 0 0x22000000 0 0x22000000 0 0x06000000>,
+			 <0x43000000 4 0x40000000 4 0x40000000 1 0>;
+		interrupt-parent = <&{/interrupt-controller@3400000}>;
+		interrupts = <0 152 4>, <0 153 4>,
+			     <0 136 4>, <0 137 4>, <0 138 4>, <0 139 4>,
+			     <0 140 4>, <0 141 4>, <0 142 4>, <0 143 4>;
+		interrupt-names = "sii", "msi", "dma0", "dma1", "dma2", "dma3",
+				  "dma4", "dma5", "dma6", "dma7";
+		#interrupt-cells = <1>;
+		interrupt-map-mask = <0 0 0 7>;
+		interrupt-map = <0 0 0 1 &pcie_intx 0>, <0 0 0 2 &pcie_intx 1>,
+				<0 0 0 3 &pcie_intx 2>, <0 0 0 4 &pcie_intx 3>;
+
+		pcie_intx: legacy-interrupt-controller {
+			interrupt-controller;
+			#address-cells = <0>;
+			#interrupt-cells = <1>;
+			interrupt-parent = <&{/interrupt-controller@3400000}>;
+			interrupts = <0 152 4>;
+		};
+	};
+};
